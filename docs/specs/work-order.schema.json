{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ultima.local/schemas/work-order.schema.json",
  "title": "UltimaAgent wo-*.md 工单卡契约 v1",
  "description": "Validator 解析 Markdown 后形成的中间对象契约。structured-v1 固化四层工单结构；legacy-queue 仅用于存量卡兼容读回。",
  "oneOf": [
    {
      "$ref": "#/$defs/structuredWorkOrder"
    },
    {
      "$ref": "#/$defs/legacyWorkOrder"
    }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "lineNumber": {
      "type": "integer",
      "minimum": 1
    },
    "textItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyText"
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^T[0-9]+$"
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "files",
        "gate",
        "line"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "files": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "gate": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        }
      }
    },
    "taskDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "line",
        "files",
        "writes",
        "gate",
        "forbidden",
        "field_lines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "line": {
          "$ref": "#/$defs/lineNumber"
        },
        "files": {
          "$ref": "#/$defs/textItems"
        },
        "writes": {
          "$ref": "#/$defs/textItems"
        },
        "gate": {
          "$ref": "#/$defs/textItems"
        },
        "forbidden": {
          "$ref": "#/$defs/textItems"
        },
        "field_lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "writes",
            "gate",
            "forbidden"
          ],
          "properties": {
            "files": {
              "$ref": "#/$defs/lineNumber"
            },
            "writes": {
              "$ref": "#/$defs/lineNumber"
            },
            "gate": {
              "$ref": "#/$defs/lineNumber"
            },
            "forbidden": {
              "$ref": "#/$defs/lineNumber"
            }
          }
        }
      }
    },
    "structuredWorkOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "title",
        "version",
        "status",
        "tool",
        "link",
        "prereq",
        "workdir",
        "revision",
        "usage",
        "plan_ref",
        "runtime",
        "scope_do",
        "scope_not_do",
        "task_table",
        "task_details"
      ],
      "properties": {
        "profile": {
          "const": "structured-v1"
        },
        "title": {
          "type": "string",
          "pattern": "^# Codex 工单 · "
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+(?:\\.[0-9]+)*$"
        },
        "status": {
          "enum": [
            "可开工",
            "排队中",
            "待开工",
            "已冻结",
            "已完成"
          ]
        },
        "tool": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "link": {
          "type": "string",
          "pattern": "^wo-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "prereq": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "workdir": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "usage": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "plan_ref": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "scope_do": {
          "$ref": "#/$defs/textItems"
        },
        "scope_not_do": {
          "$ref": "#/$defs/textItems"
        },
        "task_table": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskSummary"
          }
        },
        "task_details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskDetail"
          }
        }
      }
    },
    "legacyWorkOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "title",
        "body_line_count",
        "legacy_sections"
      ],
      "properties": {
        "profile": {
          "const": "legacy-queue"
        },
        "title": {
          "type": "string",
          "pattern": "^# "
        },
        "raw_status": {
          "type": "string"
        },
        "body_line_count": {
          "type": "integer",
          "minimum": 2
        },
        "legacy_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "heading",
              "line"
            ],
            "properties": {
              "heading": {
                "$ref": "#/$defs/nonEmptyText"
              },
              "line": {
                "$ref": "#/$defs/lineNumber"
              }
            }
          }
        }
      }
    }
  }
}
