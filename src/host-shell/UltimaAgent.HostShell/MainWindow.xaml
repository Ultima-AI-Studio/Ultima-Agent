<Window
    x:Class="UltimaAgent.HostShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ultima Agent">

    <Grid Background="#0F1420" AutomationProperties.Name="Ultima Agent host shell">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="Assets/HarmonyOS_Sans.ttf#HarmonyOS Sans"
                FontSize="32"
                FontWeight="SemiBold"
                Foreground="#E6EAF2"
                Text="Ultima Agent" />
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="Assets/HarmonyOS_Sans_SC.ttf#HarmonyOS Sans SC"
                FontSize="14"
                Foreground="#9AA3B8"
                Text="宿主壳已就绪" />
        </StackPanel>
    </Grid>
</Window>
