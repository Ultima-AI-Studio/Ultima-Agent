{
  "schema_version": 2,
  "kind": "interface-routing",
  "version": "2026-11-06",
  "updated_at": "2026-11-06T13:57:29+08:00",
  "principle": "L0 本机直答 > L1 直连接口 > L2 工具调用 > L3 模型自由回答；能被前两级接住的绝不进后两级",
  "defaults": {
    "city_code": "101070101",
    "city_name": "沈阳",
    "timeout_ms": 5000,
    "lat": 41.8057,
    "lon": 123.4315
  },
  "policy": {
    "probe": {
      "samples_per_run": 3,
      "timeout_ms": 5000,
      "coverage_gate": true,
      "note": "每项跑 3 次取中位数；覆盖度不足的候选一票否决，永不当首选"
    },
    "promotion": {
      "min_ok_rate": 0.9,
      "min_speed_gain_pct": 20,
      "note": "备选要比当前首选快 20% 以上才允许换，避免单次抖动来回切"
    },
    "demotion": {
      "fail_streak": 3,
      "note": "首选连续 3 次探测失败，自动让位给下一个健康候选"
    },
    "history_max": 50,
    "autobuild": {
      "enabled": true,
      "on_miss": "build_then_answer",
      "target_primary": 1,
      "target_standby": 2,
      "min_verified": 1,
      "allow_degraded": true,
      "seed_source": "config/interface-seeds.json",
      "rebuild_policy": "never_if_primary_exists",
      "note": "意图未配置、或已配置但连一条可用首选都没有时，先调 interface_build 从种子库建路（1 主 + 2 备），建好即用并写回配置；已配置且首选可用时只走巡检升降级，不重建。"
    }
  },
  "candidate_pool_rule": "一个意图只对应一个标的，候选只能是同标的的不同来源；不同标的（恒生/道指、伦敦金/COMEX）必须拆成独立意图，否则自动升权会答错对象",
  "intents": [
