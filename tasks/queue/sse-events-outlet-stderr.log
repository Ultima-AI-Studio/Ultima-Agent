index 0000000000000000000000000000000000000000..2a785be1c810574373386d42f5e1189c3debf65f
--- /dev/null
+++ b/src/brain/events/bus.py
@@ -0,0 +1,102 @@
+"""Thread-safe event bus used by the agent server and source modules."""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+from collections.abc import Callable
+from typing import Any
+
+from .journal import EventJournal
+
+EventHandler = Callable[[dict[str, Any]], None]
+
+
+def _clone(value: Any) -> Any:
+    return json.loads(json.dumps(value, ensure_ascii=False))
+
+
+class EventBus:
+    """Publish immutable JSON events to subscribers and a bounded journal."""
+
+    def __init__(self) -> None:
+        self._journal = EventJournal(limit=240)
+        self._lock = threading.RLock()
+        self._next_id = 1
+        self._subscribers: dict[int, EventHandler] = {}
+        self._next_subscriber_id = 1
+        self._sticky: dict[str, dict[str, Any]] = {}
+
+    def emit_event(
+        self,
+        event_type: str,
+        data: dict[str, Any],
+        *,
+        sticky: bool = False,
+    ) -> dict[str, Any]:
+        if not isinstance(event_type, str) or not event_type.strip():
+            raise ValueError("event type must be a non-empty string")
+        if not isinstance(data, dict):
+            raise TypeError("event data must be a dict")
+        isolated_data = _clone(data)
+        with self._lock:
+            event = {
+                "id": str(self._next_id),
+                "type": event_type,
+                "data": isolated_data,
+                "ts": time.time(),
+            }
+            self._next_id += 1
+            self._journal.append(event)
+            if sticky:
+                self._sticky[event_type] = _clone(event)
+            subscribers = list(self._subscribers.values())
+        for handler in subscribers:
+            try:
+                handler(_clone(event))
+            except Exception:
+                continue
+        return _clone(event)
+
+    def subscribe(self, handler: EventHandler) -> Callable[[], None]:
+        if not callable(handler):
+            raise TypeError("event handler must be callable")
+        with self._lock:
+            subscriber_id = self._next_subscriber_id
+            self._next_subscriber_id += 1
+            self._subscribers[subscriber_id] = handler
+
+        def unsubscribe() -> None:
+            with self._lock:
+                self._subscribers.pop(subscriber_id, None)
+
+        return unsubscribe
+
+    def get_after(self, last_event_id: str) -> list[dict[str, Any]]:
+        return self._journal.get_after(str(last_event_id))
+
+    def history(self, *, path: str = "all", limit: int | None = None) -> list[dict[str, Any]]:
+        return self._journal.history(path=path, limit=limit)
+
+    def set_sticky(self, event_type: str, data: dict[str, Any]) -> dict[str, Any]:
+        return self.emit_event(event_type, data, sticky=True)
+
+    def clear_sticky(self, event_type: str) -> None:
+        with self._lock:
+            self._sticky.pop(event_type, None)
+
+    def get_sticky(self) -> dict[str, dict[str, Any]]:
+        with self._lock:
+            return _clone(self._sticky)
+
+
+_EVENT_BUS = EventBus()
+
+
+def get_event_bus() -> EventBus:
+    return _EVENT_BUS
+
+
+def emit_event(event_type: str, data: dict[str, Any], *, sticky: bool = False) -> dict[str, Any]:
+    return _EVENT_BUS.emit_event(event_type, data, sticky=sticky)
diff --git a/src/brain/events/journal.py b/src/brain/events/journal.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a8d1ea9ba5b8174cea49cf4bbe045703f39bcfa
--- /dev/null
+++ b/src/brain/events/journal.py
@@ -0,0 +1,110 @@
+"""Thread-safe bounded event journal."""
+
+from __future__ import annotations
+
+import json
+import threading
+from typing import Any
+
+
+L1_EVENT_TYPES = frozenset(
+    {
+        "message_in",
+        "message_received",
+        "message",
+        "response",
+        "stream_start",
+        "stream_chunk",
+        "stream_end",
+        "injector_result",
+        "memories_written",
+        "agent_name_updated",
+        "tts_reply",
+        "audio_created",
+    }
+)
+L2_EVENT_TYPES = frozenset(
+    {
+        "tool_preparing",
+        "tool_executing",
+        "tool_call",
+        "command_run",
+        "command_output",
+        "focus_frame",
+        "focus_compressed",
+    }
+)
+L3_EVENT_TYPES = frozenset(
+    {
+        "tick",
+        "heartbeat_settings_updated",
+        "social_status",
+        "key_configured",
+        "browser_preview",
+        "error",
+        "scheduled_task",
+        "scheduled_task_completed",
+        "scheduled_task_retry",
+        "scheduled_task_failed",
+        "processing_preempted",
+        "llm_retry",
+        "message_requeued",
+        "message_dropped",
+        "protocol_violation",
+        "task_advance",
+        "audit_record",
+    }
+)
+VALID_PATHS = frozenset({"all", "l1", "l2", "l3"})
+
+
+def _clone(value: Any) -> Any:
+    return json.loads(json.dumps(value, ensure_ascii=False))
+
+
+def event_path(event_type: str) -> str:
+    if event_type in L1_EVENT_TYPES:
+        return "l1"
+    if event_type in L2_EVENT_TYPES:
+        return "l2"
+    return "l3"
+
+
+class EventJournal:
+    """Keep the latest events in insertion order with cursor lookup."""
+
+    def __init__(self, limit: int = 240) -> None:
+        if limit <= 0:
+            raise ValueError("journal limit must be positive")
+        self._limit = limit
+        self._events: list[dict[str, Any]] = []
+        self._lock = threading.RLock()
+
+    def append(self, event: dict[str, Any]) -> None:
+        with self._lock:
+            self._events.append(_clone(event))
+            overflow = len(self._events) - self._limit
+            if overflow > 0:
+                del self._events[:overflow]
+
+    def history(self, *, path: str = "all", limit: int | None = None) -> list[dict[str, Any]]:
+        if path not in VALID_PATHS:
+            raise ValueError(f"unsupported event path: {path}")
+        with self._lock:
+            events = [
+                event
+                for event in self._events
+                if path == "all" or event_path(str(event.get("type", ""))) == path
+            ]
+            if limit is not None:
+                if limit < 0:
+                    raise ValueError("history limit must not be negative")
+                events = events[-min(limit, self._limit) :] if limit else []
+            return _clone(events)
+
+    def get_after(self, last_event_id: str) -> list[dict[str, Any]]:
+        with self._lock:
+            for index, event in enumerate(self._events):
+                if event["id"] == str(last_event_id):
+                    return _clone(self._events[index + 1 :])
+            return _clone(self._events)
