     it.appendChild(ft);it.appendChild(fc);return it;}
   function pushFlow(el,item){var feed=document.getElementById(el);feed.insertBefore(item,feed.firstChild);while(feed.children.length>5)feed.removeChild(feed.lastChild);}
 
+  function escapeHtml(value){return String(value==null?'':value).replace(/[&<>"']/g,function(ch){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];});}
+  function firstText(data){return data.text||data.content||data.message||data.query||data.reason||data.title||'';}
+  function toolFrom(data){return data.tool||data.name||(data.task&&data.task.title)||data.event_type||'tool';}
+  function addChat(data){var text=firstText(data);if(!text)return;var role=String(data.role||data.speaker||'jarvis').toLowerCase();
+    var b=document.createElement('div');b.className='bubble '+(role==='user'?'user':'ai');
+    var who=document.createElement('div');who.className='who';who.textContent=role==='user'?'USER':'JARVIS';
+    var body=document.createElement('div');body.className='txt';body.textContent=text;b.appendChild(who);b.appendChild(body);
+    var feed=document.getElementById('chat-feed');feed.appendChild(b);while(feed.children.length>3)feed.removeChild(feed.firstChild);}
+  function eventSummary(type,data){
+    if(type==='task_advance')return (data.task_id||'task')+' → '+(data.phase||'');
+    if(type==='audit_record')return (data.source||data.node||'audit')+' · '+(data.event_type||data.decision||'recorded');
+    if(type==='tool_call'&&data.report)return (data.report.model||toolFrom(data))+' · '+((data.report.self_check||{}).gate||'done');
+    return firstText(data)||toolFrom(data);}
+  function handleEvent(type,data){
+    var corner=EVENT_CORNERS[type];if(!corner)return;
+    if(corner==='w-agent')pushFlow('flow-l1',flowItem(type==='error'?'err':'',type,escapeHtml(firstText(data)||JSON.stringify(data))));
+    if(type==='tick'){
+      pushPulse(1.0);hbCount++;document.getElementById('hb-count').textContent=hbCount;
+      if(data.tok_s!=null)document.getElementById('s-tok').textContent=data.tok_s;
+      if(data.nodes!=null)document.getElementById('s-node').textContent=data.nodes;
+      if(data.links!=null)document.getElementById('s-link').textContent=data.links;
+    }
+    if(type==='message')addChat(data);
+    if(type==='tool_executing'||type==='tool_call'||type==='task_advance'){
+      var tool=toolFrom(data);if(type.indexOf('tool_')===0)recordAct(tool);
+      document.getElementById('cur-tool').textContent=toolName(tool);
+      document.getElementById('cog-state').textContent=type==='tool_executing'?'思考中':'L3 待命 · 空闲';
+      pushFlow('flow-hb',flowItem(type==='tool_call'?'ok':'',type,'<span class="tool">'+escapeHtml(toolName(tool))+'</span> '+escapeHtml(eventSummary(type,data))));
+    }else if(type==='audit_record'||type==='processing_preempted'){
+      pushFlow('flow-hb',flowItem(type==='processing_preempted'?'err':'',type,escapeHtml(eventSummary(type,data))));
+    }
+  }
+  function handleSSE(evt){
+    var envelope;try{envelope=JSON.parse(evt.data);}catch(_){return;}
+    if(evt.lastEventId)sessionStorage.setItem(LAST_EVENT_KEY,evt.lastEventId);
+    handleEvent(envelope.type||evt.type,envelope.data||{});
+  }
+  function setConnection(label,ok){document.getElementById('conn-state').textContent=label;document.getElementById('hb-dot').className='led '+(ok?'g':'w');}
+  function stopReal(){if(reconnectTimer){clearTimeout(reconnectTimer);reconnectTimer=null;}if(eventSource){eventSource.close();eventSource=null;}}
+  function connectSSE(){
+    if(demo)return;stopReal();setConnection('连接中',false);
+    var cursor=sessionStorage.getItem(LAST_EVENT_KEY)||'';
+    var eventsUrl='http://127.0.0.1:8756/events?client_id=hud-corner&last_event_id='+encodeURIComponent(cursor);
+    eventSource=new EventSource(eventsUrl);
+    eventSource.addEventListener('connected',function(evt){setConnection('Token 流',true);handleSSE(evt);});
+    eventSource.addEventListener('ping',function(){setConnection('Token 流',true);});
+    Object.keys(EVENT_CORNERS).forEach(function(type){eventSource.addEventListener(type,handleSSE);});
+    eventSource.onerror=function(){if(demo)return;stopReal();setConnection('3s 后重连',false);reconnectTimer=setTimeout(connectSSE,3000);};
+  }
