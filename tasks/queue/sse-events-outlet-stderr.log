+            sent_ids: set[str] = set()
+            for event in EVENT_BUS.get_sticky().values():
+                self._write_sse(event["type"], event, event["id"])
+                sent_ids.add(event["id"])
+
+            replay = EVENT_BUS.get_after(last_event_id) if last_event_id else history
+            for event in replay:
