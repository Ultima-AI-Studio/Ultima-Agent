 240: class TaskQueue:
 241:     """任务队列：闭环状态机 + 视图。"""
 242: 
 243:     def __init__(self, data_dir: str | Path, *, registrar: Optional[GlobalQueueRegistrar] = None) -> None:
 244:         self.data_dir = Path(data_dir)
 245:         self.queue_path = self.data_dir / "task-queue.json"
 246:         self.data_dir.mkdir(parents=True, exist_ok=True)
 247:         self._tasks: dict[str, TaskRecord] = {}
 248:         self.registrar = registrar
 249:         self._load()
 250: 
 251:     def _load(self) -> None:
 252:         if self.queue_path.exists():
 253:             try:
 254:                 data = json.loads(self.queue_path.read_text(encoding="utf-8"))
 255:                 for tid, obj in data.items():
 256:                     self._tasks[tid] = TaskRecord(**obj)
 257:             except (json.JSONDecodeError, TypeError):
 258:                 pass
 259: 
 260:     def _save(self) -> None:
 261:         self.queue_path.write_text(
 262:             json.dumps({k: v.as_dict() for k, v in self._tasks.items()},
 263:                        ensure_ascii=False, indent=2),
 264:             encoding="utf-8",
 265:         )
 266: 
 267:     def _touch(self, rec: TaskRecord) -> None:
 268:         rec.updated_at = _now_iso()
 269:         self._save()
 270: 
 271:     # -- 立项/排队 ----------------------------------------------------------
 272: 
 273:     def create(
 274:         self,
 275:         title: str,
 276:         *,
 277:         priority: int = 0,
 278:         permissions: tuple[str, ...] = (),
 279:         parent_task: Optional[str] = None,
 280:         project_key: str = "ultimaagent",
 281:     ) -> TaskRecord:
 282:         if not PROJECT_KEY_RE.fullmatch(project_key):
 283:             raise OrchestratorError(f"非法 project_key {project_key!r}")
 284:         lock_path = self.queue_path.with_suffix(".numbering.lock")
 285:         try:
 286:             lock_fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
 287:         except FileExistsError as exc:
 288:             raise OrchestratorError("工单编号核发冲突：另一个进程正在抢号") from exc
 289:         try:
 290:             os.close(lock_fd)
 291:             self._load()
 292:             registered_date = _shanghai_date()
 293:             prefix = f"wo-{project_key}-{registered_date}-"
 294:             used = []
 295:             for task_id in self._tasks:
 296:                 if task_id.startswith(prefix) and task_id[len(prefix):].isdigit():
 297:                     used.append(int(task_id[len(prefix):]))
 298:             sequence = max(used, default=0) + 1
 299:             if sequence > 9999:
 300:                 raise OrchestratorError(f"工单编号已耗尽 {prefix}NNNN")
 301:             task_id = f"{prefix}{sequence:04d}"
 302:             if task_id in self._tasks:
 303:                 raise OrchestratorError(f"工单编号核发冲突 {task_id}")
 304:             rec = TaskRecord(
 305:                 task_id=task_id,
 306:                 title=title,
 307:                 phase="立项",
 308:                 priority=priority,
 309:                 permissions=permissions,
 310:                 parent_task=parent_task,
 311:                 project_key=project_key,
 312:             )
 313:             rec.history.append({"ts": _now_iso(), "phase": "立项", "note": "任务登记"})
 314:             self._tasks[rec.task_id] = rec
 315:             self._save()
 316:             return rec
 317:         finally:
 318:             lock_path.unlink(missing_ok=True)
 319: 
 320:     def enqueue(self, task_id: str) -> None:
 321:         rec = self._require(task_id)
 322:         self._assert_wip(rec, "排队")
 323:         rec.phase = "排队"
 324:         rec.history.append({"ts": _now_iso(), "phase": "排队"})
 325:         self._touch(rec)
 326:         self._register(rec, "排队")
 327: 
 328:     def advance(self, task_id: str, phase: str) -> None:
 329:         if phase not in PHASES:
 330:             raise OrchestratorError(f"非法阶段 {phase}")
 331:         rec = self._require(task_id)
 332:         expected = PHASES[PHASES.index(rec.phase) + 1] if PHASES.index(rec.phase) + 1 < len(PHASES) else None
 333:         if phase != expected:
 334:             raise OrchestratorError(f"阶段跳迁：{rec.phase} → {phase}（应为 {expected}）")
 335:         if phase in ("派发", "执行", "审计"):
 336:             self._assert_wip(rec, phase)
 337:         rec.phase = phase
 338:         rec.history.append({"ts": _now_iso(), "phase": phase})
 339:         self._touch(rec)
 340:         self._register(rec, phase)
 341: 
 342:     def _register(self, rec: TaskRecord, phase: str) -> None:
 343:         if self.registrar is not None:
 344:             self.registrar.record(rec, phase)
 345: 
 346:     def check_wip(self, task_id: str, target_phase: str) -> dict[str, Any]:
 347:         rec = self._require(task_id)
 348:         if self.registrar is None:
 349:             maximum = 1 if target_phase == "审计" else 3
 350:             return {
 351:                 "allowed": True,
 352:                 "reason": "未配置全局主表，WIP 检查 fail-open",
 353:                 "current_executing": 0,
 354:                 "max_executing": maximum,
 355:             }
 356:         return self.registrar.check_wip(
 357:             rec.project_key,
 358:             target_phase,
 359:             task_id=rec.task_id,
 360:         )
 361: 
 362:     def _assert_wip(self, rec: TaskRecord, target_phase: str) -> None:
 363:         result = self.check_wip(rec.task_id, target_phase)
 364:         if not result["allowed"]:
 365:             raise OrchestratorError(result["reason"])
 366: 
 367:     def _require(self, task_id: str) -> TaskRecord:
 368:         rec = self._tasks.get(task_id)
 369:         if rec is None:
 370:             raise OrchestratorError(f"任务不存在 {task_id}")
 371:         return rec
 372: 
 373:     # -- 子代理权限继承 -----------------------------------------------------
 374: 
 375:     def dispatch_subtask(
 376:         self,
 377:         parent_task_id: str,
 378:         title: str,
 379:         permissions: tuple[str, ...],
 380:     ) -> TaskRecord:
 381:         """派发子任务：权限必须是主任务权限子集，越权拒绝。"""
 382:         parent = self._require(parent_task_id)
 383:         inherited = set(permissions)
 384:         parent_perm = set(parent.permissions)
 385:         if not inherited.issubset(parent_perm):
 386:             raise OrchestratorError(
 387:                 f"子任务越权：{sorted(inherited - parent_perm)} 超出主任务权限"
 388:             )
 389:         sub = self.create(title, priority=parent.priority,
 390:                           permissions=permissions, parent_task=parent_task_id,
 391:                           project_key=parent.project_key)
 392:         sub.phase = "排队"
 393:         sub.history.append({"ts": _now_iso(), "phase": "排队", "note": f"子任务派发（父 {parent_task_id}）"})
 394:         self._save()
 395:         return sub
 396: 
 397:     # -- 失败重规划 ---------------------------------------------------------
 398: 
 399:     def replan(self, task_id: str, note: str = "", max_replans: int = 3) -> dict[str, Any]:
 400:         rec = self._require(task_id)
 401:         if rec.replan_count >= max_replans:
 402:             return {"replanned": False, "reason": f"重规划超预算（{max_replans}）", "task_id": task_id}
 403:         rec.replan_count += 1
 404:         rec.phase = "排队"
 405:         rec.history.append({"ts": _now_iso(), "phase": "排队", "note": f"失败重规划[{rec.replan_count}]: {note}"})
 406:         self._touch(rec)
 407:         self._register(rec, "排队")
 408:         return {"replanned": True, "replan_count": rec.replan_count, "task_id": task_id}
 409: 
 410:     # -- 回执 ---------------------------------------------------------------
 411: 
 412:     def complete(self, task_id: str, receipt: dict[str, Any]) -> None:
 413:         rec = self._require(task_id)
 414:         rec.receipt = receipt
 415:         rec.phase = "回执"
 416:         rec.history.append({"ts": _now_iso(), "phase": "回执", "note": "回执落盘"})
 417:         self._touch(rec)
 418:         self._register(rec, "冻结")
 419: 
 420:     # -- 视图 ---------------------------------------------------------------
 421: 
 422:     def view(self) -> list[dict[str, Any]]:
 423:         """队列视图（宿主端一致）：task_id/state/priority/title。"""
 424:         rows = []
 425:         for rec in self._tasks.values():
 426:             rows.append({
 427:                 "task_id": rec.task_id, "state": rec.phase, "priority": rec.priority,
 428:                 "title": rec.title, "parent_task": rec.parent_task,
 429:             })
 430:         rows.sort(key=lambda r: (-r["priority"], r["task_id"]))
 431:         return rows

