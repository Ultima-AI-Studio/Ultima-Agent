 190: # ---------------------------------------------------------------------------
 191: # 主脑决策回路
 192: # ---------------------------------------------------------------------------
 193: class BrainLoop:
 194:     """主脑决策回路：受理 → 意图 → 领域 → 范式 → 规划 → 派发 → 闸门
 195:     → 执行 → 审计(四查三态) → 编排 → 表达 → 呈现 → 记忆归档。"""
 196: 
 197:     def __init__(
 198:         self,
 199:         data_dir: str | Path,
 200:         *,
 201:         gate: Any = None,
 202:         queue: Any = None,
 203:         scope: Any = None,
 204:         audit: Any = None,
 205:         memory: Any = None,
 206:         behavior: Any = None,
 207:         executor: Optional[Callable[[dict[str, Any], ExecutionParams], dict[str, Any]]] = None,
 208:         resolve_domain: Optional[Callable[[str], str]] = None,
 209:         parse_intent: Optional[Callable[[str], dict[str, Any]]] = None,
 210:     ) -> None:
 211:         self.data_dir = Path(data_dir)
 212:         self.data_dir.mkdir(parents=True, exist_ok=True)
 213:         # 默认组件（可注入替换；全部用临时目录/内存，测试不污染真实库）
 214:         from ..guardrails.paradigm import ParadigmGate
 215:         from ..orchestration.queue import TaskQueue
 216:         from ..guardrails.scope import ScopePolicy
 217:         from ..guardrails.audit_log import AppendOnlyAuditLog
 218:         from ..memory.layers import MemoryLayers
 219:         from ..display.behavior import BehaviorMapper
 220: 
 221:         self.gate = gate if gate is not None else ParadigmGate()
 222:         self.queue = queue if queue is not None else TaskQueue(self.data_dir / "queue")
 223:         self.scope = scope if scope is not None else ScopePolicy(
 224:             cap=["exec.run"], dev=["read"], cred=[]
 225:         )
 226:         self.audit = audit if audit is not None else AppendOnlyAuditLog(self.data_dir / "audit.jsonl")
 227:         self.memory = memory if memory is not None else MemoryLayers(self.data_dir / "memory")
 228:         self.behavior = behavior if behavior is not None else BehaviorMapper()
 229:         self.executor = executor if executor is not None else ExternalExecutorStub().run
 230:         self.resolve_domain = resolve_domain or self._default_domain
 231:         self.parse_intent = parse_intent or self._default_intent
 232: 
 233:     # -- 轻量默认实现（可注入替换） -----------------------------------------
 234: 
 235:     def _default_intent(self, query: str) -> dict[str, Any]:
 236:         q = query.lower()
 237:         if any(k in q for k in ("任务", "队列", "状态", "task", "queue")):
 238:             return {"name": "task_status", "slots": {"query": query}}
 239:         return {"name": "unknown", "slots": {"query": query}}
 240: 
 241:     def _default_domain(self, intent_name: str) -> str:
 242:         return {"task_status": "task", "unknown": "core"}.get(intent_name, "core")
 243: 
 244:     # -- 记忆热度轴钩子（s7-memory-temperature） ------------------------------
 245: 
 246:     def record_interrupt(
 247:         self,
 248:         query: str,
 249:         *,
 250:         state: Optional[dict[str, Any]] = None,
 251:         session: Optional[str] = None,
 252:     ) -> Optional[str]:
 253:         """打断不遗忘：被打断轮次写入 pending_interrupt 单元（working 层，默认热档）。
 254: 
 255:         字段：原指令 / 理解与执行状态 / 打断时间。下轮启动优先召回该单元，
 256:         合并上下文后可接着原任务不重来。
 257:         """
 258:         query = (query or "").strip()
 259:         if not query:
 260:             return None
 261:         try:
 262:             entry = self.memory.write(
 263:                 "working", query,
 264:                 kind="pending_interrupt", trusted=True, source="brain.loop.interrupt",
 265:                 meta={
 266:                     "state": dict(state or {}),
 267:                     "interrupted_at": _now_iso(),
 268:                     "session": session or "",
 269:                     "closed": False,
 270:                 },
 271:             )
 272:             return entry.id
 273:         except Exception:  # noqa: BLE001 - 打断写入不阻断主链路（best-effort）
 274:             return None
 275: 
 276:     def resume_interrupt(self, session: Optional[str] = None) -> Optional[dict[str, Any]]:
 277:         """下轮启动优先召回未闭环打断单元；返回合并上下文（含原指令/状态）。"""
 278:         try:
 279:             hits = self.memory.read(
 280:                 "", layer="working", kinds=("pending_interrupt",), top_k=1,
 281:             )
 282:         except Exception:  # noqa: BLE001
 283:             return None
 284:         for entry in hits:
 285:             if entry.meta.get("closed"):
 286:                 continue
 287:             if session and entry.meta.get("session") and entry.meta.get("session") != session:
 288:                 continue
 289:             state = dict(entry.meta.get("state") or {})
 290:             state["resumed_from"] = entry.id
 291:             state["original_query"] = entry.content
 292:             return state
 293:         return None
 294: 
 295:     def close_interrupt(self, entry_id: str) -> bool:
 296:         """打断单元闭环（任务完成/用户确认放弃）：标记 closed。"""
 297:         entry = self.memory.get_by_id(entry_id) if hasattr(self.memory, "get_by_id") else None
 298:         if entry is None:
 299:             return False
 300:         entry.meta["closed"] = True
 301:         entry.meta["closed_at"] = _now_iso()
 302:         try:
 303:             self.memory.demote_warm(entry_id)  # 闭环后转温档保留
 304:             return True
 305:         except Exception:  # noqa: BLE001
 306:             return False
 307: 
 308:     def end_session(self, session: Optional[str] = None) -> int:
 309:         """会话结束钩子：working 层 hot 条目批量 demote_warm；未闭环打断单元转温档保留。
 310: 
 311:         返回处理的条目数。
 312:         """
 313:         try:
 314:             if hasattr(self.memory, "demote_all_hot"):
 315:                 return int(self.memory.demote_all_hot("working"))
 316:         except Exception:  # noqa: BLE001 - 会话收尾不阻断主链路（best-effort）
 317:             return 0
 318:         return 0
