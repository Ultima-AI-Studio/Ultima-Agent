+                        "data": {"service_time": time.time()},
+                        "ts": time.time(),
+                    }
+                    self._write_sse("ping", ping)
+                    continue
+                if event["id"] in sent_ids:
+                    continue
+                self._write_sse(event["type"], event, event["id"])
+                sent_ids.add(event["id"])
+        except (BrokenPipeError, ConnectionResetError, OSError):
+            return
+        finally:
+            unsubscribe()
