char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
dot ::= [^\x0A\x0D]
path ::= ("\"research.md\"")
path-kv ::= "\"path\"" space ":" space path
root ::= "{" space path-kv "," space title-kv "," space sections-kv space "}"
sections ::= "[" space sections-item ("," space sections-item){2,4} space "]"
sections-item ::= sections-item-0 | sections-item-1 | sections-item-2
sections-item-0 ::= "{" space sections-item-0-source-id-kv "," space sections-item-0-heading-kv "," space sections-item-0-facts-kv space "}"
sections-item-0-facts ::= "[" space sections-item-0-facts-item ("," space sections-item-0-facts-item){0,5} space "]"
sections-item-0-facts-item ::= sections-item-0-facts-item-0 | sections-item-0-facts-item-1 | sections-item-0-facts-item-2
sections-item-0-facts-item-0 ::= "{" space sections-item-0-facts-item-0-claim-kv "," space sections-item-0-facts-item-0-evidence-id-kv space "}"
sections-item-0-facts-item-0-claim ::= "\"" ((dot* [^A-Za-z0-9_$.])? "$ru" "n" ([^A-Za-z0-9_$.] dot* | "." ([^A-Za-z_$] dot*)?)?) "\""
sections-item-0-facts-item-0-claim-kv ::= "\"claim\"" space ":" space sections-item-0-facts-item-0-claim
sections-item-0-facts-item-0-evidence-id ::= ("\"N3.0000000000000001\"")
sections-item-0-facts-item-0-evidence-id-kv ::= "\"evidence_id\"" space ":" space sections-item-0-facts-item-0-evidence-id
sections-item-0-facts-item-1 ::= "{" space sections-item-0-facts-item-1-claim-kv "," space sections-item-0-facts-item-1-evidence-id-kv space "}"
sections-item-0-facts-item-1-claim ::= "\"" ((dot* [^A-Za-z0-9_$.])? "client.sto" "p" ([^A-Za-z0-9_$.] dot* | "." ([^A-Za-z_$] dot*)?)?) "\""
sections-item-0-facts-item-1-claim-kv ::= "\"claim\"" space ":" space sections-item-0-facts-item-1-claim
sections-item-0-facts-item-1-evidence-id ::= ("\"N3.0000000000000004\"")
sections-item-0-facts-item-1-evidence-id-kv ::= "\"evidence_id\"" space ":" space sections-item-0-facts-item-1-evidence-id
sections-item-0-facts-item-2 ::= "{" space sections-item-0-facts-item-2-claim-kv "," space sections-item-0-facts-item-2-evidence-id-kv space "}"
sections-item-0-facts-item-2-claim ::= "\"" char+ "\""
sections-item-0-facts-item-2-claim-kv ::= "\"claim\"" space ":" space sections-item-0-facts-item-2-claim
sections-item-0-facts-item-2-evidence-id ::= ("\"N3.0000000000000005\"")
sections-item-0-facts-item-2-evidence-id-kv ::= "\"evidence_id\"" space ":" space sections-item-0-facts-item-2-evidence-id
sections-item-0-facts-kv ::= "\"facts\"" space ":" space sections-item-0-facts
sections-item-0-heading ::= "\"" char+ "\""
sections-item-0-heading-kv ::= "\"heading\"" space ":" space sections-item-0-heading
sections-item-0-source-id ::= ("\"S1\"")
sections-item-0-source-id-kv ::= "\"source_id\"" space ":" space sections-item-0-source-id
sections-item-1 ::= "{" space sections-item-1-source-id-kv "," space sections-item-1-heading-kv "," space sections-item-1-facts-kv space "}"
sections-item-1-facts ::= "[" space sections-item-1-facts-item ("," space sections-item-1-facts-item){0,5} space "]"
sections-item-1-facts-item ::= "{" space sections-item-1-facts-item-claim-kv "," space sections-item-1-facts-item-evidence-id-kv space "}"
sections-item-1-facts-item-claim ::= "\"" char+ "\""
sections-item-1-facts-item-claim-kv ::= "\"claim\"" space ":" space sections-item-1-facts-item-claim
sections-item-1-facts-item-evidence-id ::= ("\"N3.0000000000000002\"")
sections-item-1-facts-item-evidence-id-kv ::= "\"evidence_id\"" space ":" space sections-item-1-facts-item-evidence-id
sections-item-1-facts-kv ::= "\"facts\"" space ":" space sections-item-1-facts
sections-item-1-heading ::= "\"" char+ "\""
sections-item-1-heading-kv ::= "\"heading\"" space ":" space sections-item-1-heading
sections-item-1-source-id ::= ("\"S2\"")
sections-item-1-source-id-kv ::= "\"source_id\"" space ":" space sections-item-1-source-id
sections-item-2 ::= "{" space sections-item-2-source-id-kv "," space sections-item-2-heading-kv "," space sections-item-2-facts-kv space "}"
sections-item-2-facts ::= "[" space sections-item-2-facts-item ("," space sections-item-2-facts-item){0,5} space "]"
sections-item-2-facts-item ::= "{" space sections-item-2-facts-item-claim-kv "," space sections-item-2-facts-item-evidence-id-kv space "}"
sections-item-2-facts-item-claim ::= "\"" ((dot* [^A-Za-z0-9_$.])? "console.lo" "g" ([^A-Za-z0-9_$.] dot* | "." ([^A-Za-z_$] dot*)?)?) "\""
sections-item-2-facts-item-claim-kv ::= "\"claim\"" space ":" space sections-item-2-facts-item-claim
sections-item-2-facts-item-evidence-id ::= ("\"N3.0000000000000003\"")
sections-item-2-facts-item-evidence-id-kv ::= "\"evidence_id\"" space ":" space sections-item-2-facts-item-evidence-id
sections-item-2-facts-kv ::= "\"facts\"" space ":" space sections-item-2-facts
sections-item-2-heading ::= "\"" char+ "\""
sections-item-2-heading-kv ::= "\"heading\"" space ":" space sections-item-2-heading
sections-item-2-source-id ::= ("\"S3\"")
sections-item-2-source-id-kv ::= "\"source_id\"" space ":" space sections-item-2-source-id
sections-kv ::= "\"sections\"" space ":" space sections
space ::= | " " | "\n"{1,2} [ \t]{0,20}
title ::= "\"" char+ "\""
title-kv ::= "\"title\"" space ":" space title