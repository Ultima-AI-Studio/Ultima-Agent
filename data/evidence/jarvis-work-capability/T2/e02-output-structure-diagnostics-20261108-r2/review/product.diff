+@pytest.mark.parametrize('fault',['no_context','entity_mismatch','schema_mismatch','packet_scan'])
+def test_optional_context_failure_keeps_original_v4(tmp_path,sdk_io,mock_jar,monkeypatch,fault):
+    original=d.record_native_response_rejection
+    def record(*args,**kwargs):
+        if fault=='no_context':kwargs={}
+        elif fault=='entity_mismatch':kwargs['request_context']['entity']+=b' '
+        elif fault=='schema_mismatch':kwargs['request_context']['strict_schema']={'type':'string'}
+        original(*args,**kwargs)
+        if fault=='packet_scan':
+            scan=args[0]._scan_output
+            def reject_v5(value):
+                if type(value) is dict and value.get('kind')==d.OUTPUT_KIND:raise ValueError('synthetic scan rejection')
+                return scan(value)
+            args[0]._scan_output=reject_v5
+    monkeypatch.setattr(d,'record_native_response_rejection',record)
+    result,ledger,_,_=native_refusal(tmp_path,sdk_io,mock_jar,monkeypatch)
+    p=private_packet(result,ledger)
+    assert p['kind']==d.KIND and p['native_response']['reason']=='done_reason'
+    assert result['error']=='Invalid native research response' and not list(tmp_path.rglob('research.md'))
+
+
+def test_unencodable_content_is_metadata_only(tmp_path,sdk_io,mock_jar,monkeypatch):
+    original=d.build_output_structure;arguments=[]
+    def observe(*args,**kwargs):arguments.append((args,kwargs));return original(*args,**kwargs)
+    monkeypatch.setattr(d,'build_output_structure',observe)
+    native_refusal(tmp_path,sdk_io,mock_jar,monkeypatch)
+    args,original_kwargs=arguments[0];kwargs=dict(original_kwargs);kwargs['native_record']=dict(kwargs['native_record'])
+    raw=copy.deepcopy(args[0]);raw['message']['content']='\ud800'
+    # A separate synthetic raw record exercises encoding without an actual model exchange.
+    body=json.dumps(raw,ensure_ascii=True).encode('ascii')
+    kwargs['native_record'].update(content_chars=1,response_bytes=len(body),response_sha256=hashlib.sha256(body).hexdigest())
+    s=original(raw,**kwargs)
+    assert s['json']['status']=='UNAVAILABLE' and s['evidence']==dict(mode='UNAVAILABLE',fragments=[],omitted_chars=1)
+    assert s['message']['content']==dict(type='string',chars=1,bytes=None,sha256=None)
+
+
+def test_exact_packet_cap_and_metadata_fallback(tmp_path,sdk_io,mock_jar,monkeypatch):
+    result,ledger,_,bodies=native_refusal(tmp_path,sdk_io,mock_jar,monkeypatch,
+        updates=[('done_reason','length'),('message.content','x')])
+    p,_=captured(result,ledger);original=json.loads(bodies[-1])
+    def sized(size):
+        # Synthetic packet sizing uses the real fixture shape, not an acceptance receipt.
+        packet=copy.deepcopy(p);s=packet['output_structure'];content='x'*size
+        raw=copy.deepcopy(original);raw['message']['content']=content
+        body=json.dumps(raw,ensure_ascii=False).encode('utf8')
+        packet['native_response'].update(response_bytes=len(body),response_sha256=hashlib.sha256(body).hexdigest(),content_chars=size)
+        packet['last_http'].update(downloaded=len(body),inspected=len(body),admitted=len(body),retained=len(body))
+        s['native_binding'].update({k:packet['native_response'][k] for k in s['native_binding']})
+        s['message']['content']=dict(type='string',chars=size,bytes=size,sha256=hashlib.sha256(content.encode()).hexdigest())
+        s['evidence']=dict(mode='FULL',fragments=[dict(start=0,end=size,text=content)],omitted_chars=0)
+        return packet
+    size=10000
+    for _ in range(6):
+        exact=sized(size);delta=16384-len(canonical_v3(exact))
+        if delta==0:break
+        size+=delta
+    assert len(canonical_v3(exact))==16384
+    base=copy.deepcopy(exact);snapshot=base.pop('output_structure');base['kind']=d.KIND
+    fitted=d.attach_output_structure(base,snapshot,ledger._scan_output)
+    assert fitted==exact and d.validate_failure_diagnostic(canonical_v3(fitted),ledger._navigation.binding_key)==fitted
+    too_big=sized(size+1);s=too_big.pop('output_structure');too_big['kind']=d.KIND
+    fitted=d.attach_output_structure(too_big,s,ledger._scan_output)
+    assert fitted['output_structure']['evidence']['mode']=='EXCERPTS' and len(canonical_v3(fitted))<=16384
+    assert fitted['pages']==too_big['pages']
+    # Exhaust only this unit's available space to prove the mandatory old-packet fallback.
+    monkeypatch.setattr(d,'CAP',len(canonical_v3(base)))
+    assert d.attach_output_structure(base,snapshot,ledger._scan_output)==base
+
