+def canonical_proof(core, source):
+    # Captured controller callback; no vendor patch, entity rewrite or HTTP hook.
+    check_wire = wire_gate(core, source)
+    def check(body, leaf):
+        import httpx
+        verify_messages(core, source, leaf.expected_raw_messages, leaf.ledger.schema, 'raw_messages')
+        check_wire(httpx.Request('POST', core.ORIGIN+'/api/chat', json=body))
+    return check
+
+
+def preserve_failure(output, exc, source, phase, records):
+    failure = dict(type=type(exc).__name__, message=str(exc), phase=phase,
+                   classification='post_run_audit_failure' if output is not None else 'pre_core_failure')
+    if output is not None:
+        # Preserve every observed effect, stage state, counter, envelope and event.
+        output.setdefault('audit_failures', []).append(failure)
+        output['mechanical_status_before_audit'] = output['status']
+        output['status'] = 'FAILED'
+        return output
+    # Observer rows are send observations, not transport or delivery confirmation.
+    return dict(status='FAILED', source_id=source, error=failure, phase=phase,
+                native_posts=None, native_post_intents=None, transport_delivery='unconfirmed',
+                observed_http_send_rows=len(records), effects=None, owner_closed=False,
+                effects_observation='Unknown: core did not return an observed packet')
+
