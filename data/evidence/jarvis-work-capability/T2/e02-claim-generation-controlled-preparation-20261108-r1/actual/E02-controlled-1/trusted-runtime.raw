},{\\\"available\\\":true,\\\"identity\\\":\\\"raw.githubusercontent.com/open-jarvis/OpenJarvis/0eb7811df96cf139e6bd6d7fcc9b5cc4ff1418ff/src/openjarvis/agents/native_react.py\\\",\\\"landmarks\\\":[[61,61,\\\"\\\"],[96,96,\\\"value.strip\\\"],[175,175,\\\"text.strip\\\"],[215,219,\\\"re.search\\\"],[265,265,\\\"messages.insert\\\"],[291,291,\\\"self._emit_turn_end\\\"],[337,340,\\\"self._loop_guard.check_call\\\"],[360,364,\\\"self._max_turns_result\\\"]],\\\"reason\\\":\\\"\\\",\\\"source_id\\\":\\\"S4\\\",\\\"suffix\\\":\\\".py\\\",\\\"total_lines\\\":367}]\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 26\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.2964bfdba5189bec\\\",\\\"documented\\\",\\\"\\\",26,26,26,30],[\\\"N3.404239faf4ada9c7\\\",\\\"documented\\\",\\\"\\\",28,29,26,32],[\\\"N3.2cb5219edd135f44\\\",\\\"documented\\\",\\\"\\\",31,32,28,35],[\\\"N3.7d926264e5f7845e\\\",\\\"documented\\\",\\\"\\\",34,34,31,38],[\\\"N3.7e68a47ac05ad2f2\\\",\\\"documented\\\",\\\"\\\",36,36,33,40],[\\\"N3.8b3efd3e1e79f38f\\\",\\\"documented\\\",\\\"\\\",38,38,35,42],[\\\"N3.540a9d7be41a4cdf\\\",\\\"documented\\\",\\\"\\\",40,43,38,45],[\\\"N3.2b97d4feb2b01dff\\\",\\\"documented\\\",\\\"\\\",44,47,42,49]],\\\"end\\\":49,\\\"lines\\\":[[26,\\\"## The (short) story\\\"],[27,\\\"\\\"],[28,\\\"Wispr Flow raised **$81 million** to build a voice dictation app.  \\\"],[29,\\\"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it.\\\"],[30,\\\"\\\"],[31,\\\"That's it.  \\\"],[32,\\\"No funding. No team. Just one stubborn developer who hates subscriptions.\\\"],[33,\\\"\\\"],[34,\\\"This is what open source is supposed to be.\\\"],[35,\\\"\\\"],[36,\\\"---\\\"],[37,\\\"\\\"],[38,\\\"## Why people actually use it\\\"],[39,\\\"\\\"],[40,\\\"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**\\\"],[41,\\\"- Removes \\\\\\\"um\\\\\\\", \\\\\\\"like\\\\\\\", all fillers automatically\\\"],[42,\\\"- Fixes grammar, can rephrase, bullet-point, or even generate text\\\"],[43,\\\"- Tiny actions already work (\\\\\\\"open YouTube\\\\\\\", \\\\\\\"set 5-min timer\\\\\\\")\\\"],[44,\\\"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant.\\\"],[45,\\\"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)\\\"],[46,\\\"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)\\\"],[47,\\\"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`\\\"],[48,\\\"\\\"],[49,\\\"**Zero tracking. Zero telemetry. Zero bullshit.**\\\"]],\\\"next_start\\\":50,\\\"omissions\\\":[],\\\"omitted_cards\\\":1,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":26,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"d070921d652aa13be140685796a9f1154eb270f333deb43f3ae9fad96b2b9ef0\\\"}\",\"role\":\"user\"}],\"model\":\"qwen3-8b-uncensored\",\"options\":{\"num_ctx\":16384,\"num_predict\":256,\"temperature\":0},\"shift\":false,\"stream\":false,\"think\":false,\"tools\":[],\"truncate\":false}","generation":2,"hashes":{"entity":"677cf18cae49553d34767b1bca26fe69ce3d64ded641c95a39e0a767f1f857e7","messages":"fe924d0375df9ca4ca21d02c69ef7c9fc75513bbe989d58fa7d594b0d353eb24","sampler":"2cbc68fc92a28d0e38dfd30759cf9fc5a56085b5ededc607e3f7f9dab11f7f6f","strict":"9e0eeae7d6a869d1488f72303a9637801f83a796226947f5e5063d657b7075e2"},"identity":{"local_manifest_sha256":"6d7230a923426bc1933879eb08a7dafc18e5fc0e7606c459ce98f16e0c7f9330","tags_response":"{\"models\":[{\"name\":\"qwen3-8b-uncensored:latest\",\"model\":\"qwen3-8b-uncensored:latest\",\"modified_at\":\"2026-10-31T12:12:14.5586449+08:00\",\"size\":5027783913,\"digest\":\"6d7230a923426bc1933879eb08a7da