,\\\"console.log\\\"],[65,65,\\\"console.log\\\"],[70,70,\\\"Logger.info\\\"],[82,82,\\\"console.log\\\"],[88,88,\\\"Logger.error\\\"],[107,107,\\\"Logger.info\\\"]],\\\"reason\\\":\\\"\\\",\\\"source_id\\\":\\\"S3\\\",\\\"suffix\\\":\\\".ts\\\",\\\"total_lines\\\":110},{\\\"available\\\":true,\\\"identity\\\":\\\"raw.githubusercontent.com/open-jarvis/OpenJarvis/0eb7811df96cf139e6bd6d7fcc9b5cc4ff1418ff/src/openjarvis/agents/native_react.py\\\",\\\"landmarks\\\":[[61,61,\\\"\\\"],[96,96,\\\"value.strip\\\"],[175,175,\\\"text.strip\\\"],[215,219,\\\"re.search\\\"],[265,265,\\\"messages.insert\\\"],[291,291,\\\"self._emit_turn_end\\\"],[337,340,\\\"self._loop_guard.check_call\\\"],[360,364,\\\"self._max_turns_result\\\"]],\\\"reason\\\":\\\"\\\",\\\"source_id\\\":\\\"S4\\\",\\\"suffix\\\":\\\".py\\\",\\\"total_lines\\\":367}]\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 26\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.2964bfdba5189bec\\\",\\\"documented\\\",\\\"\\\",26,26,26,30],[\\\"N3.404239faf4ada9c7\\\",\\\"documented\\\",\\\"\\\",28,29,26,32],[\\\"N3.2cb5219edd135f44\\\",\\\"documented\\\",\\\"\\\",31,32,28,35],[\\\"N3.7d926264e5f7845e\\\",\\\"documented\\\",\\\"\\\",34,34,31,38],[\\\"N3.7e68a47ac05ad2f2\\\",\\\"documented\\\",\\\"\\\",36,36,33,40],[\\\"N3.8b3efd3e1e79f38f\\\",\\\"documented\\\",\\\"\\\",38,38,35,42],[\\\"N3.540a9d7be41a4cdf\\\",\\\"documented\\\",\\\"\\\",40,43,38,45],[\\\"N3.2b97d4feb2b01dff\\\",\\\"documented\\\",\\\"\\\",44,47,42,49]],\\\"end\\\":49,\\\"lines\\\":[[26,\\\"## The (short) story\\\"],[27,\\\"\\\"],[28,\\\"Wispr Flow raised **$81 million** to build a voice dictation app.  \\\"],[29,\\\"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it.\\\"],[30,\\\"\\\"],[31,\\\"That's it.  \\\"],[32,\\\"No funding. No team. Just one stubborn developer who hates subscriptions.\\\"],[33,\\\"\\\"],[34,\\\"This is what open source is supposed to be.\\\"],[35,\\\"\\\"],[36,\\\"---\\\"],[37,\\\"\\\"],[38,\\\"## Why people actually use it\\\"],[39,\\\"\\\"],[40,\\\"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**\\\"],[41,\\\"- Removes \\\\\\\"um\\\\\\\", \\\\\\\"like\\\\\\\", all fillers automatically\\\"],[42,\\\"- Fixes grammar, can rephrase, bullet-point, or even generate text\\\"],[43,\\\"- Tiny actions already work (\\\\\\\"open YouTube\\\\\\\", \\\\\\\"set 5-min timer\\\\\\\")\\\"],[44,\\\"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant.\\\"],[45,\\\"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)\\\"],[46,\\\"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)\\\"],[47,\\\"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`\\\"],[48,\\\"\\\"],[49,\\\"**Zero tracking. Zero telemetry. Zero bullshit.**\\\"]],\\\"next_start\\\":50,\\\"omissions\\\":[],\\\"omitted_cards\\\":1,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":26,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"d070921d652aa13be140685796a9f1154eb270f333deb43f3ae9fad96b2b9ef0\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 53\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.28d5a175f0153d3a\\\",\\\"documented\\\",\\\"\\\",53,53,53,57],[\\\"N3.0169b70723c8a1e9\\\",\\\"documented\\\",\\\"\\\",55,58,53,60],[\\\"N3.0c514aa47434938b\\\",\\\"documented\\\",\\\"\\\",59,59,56,63],[\\\"N3.9a12680d830ffa32\\\",\\\"documented\\\",\\\"\\\",61,61,58,65],[\\\"N3.958ed26394fea0be\\\",\\\"documented\\\",\\\"\\\",63,63,60,67],[\\\"N3.1d875d938b3ff02b\\\",\\\"documented\\\",\\\"\\\",65,65,62,69],[\\\"N3.c8a9553e2c1c77cc\\\",\\\"documented\\\",\\\"\\\",67,70,65,72],[\\\"N3.b940d4c846822f16\\\",\\\"documented\\\",\\\"\\\",71,73,69,76]],\\\"end\\\":76,\\\"lines\\\":[[53,\\\"## Download\\\"],[54,\\\"\\\"],[55,\\\"| Platform | Link |\\\"],[56,\\\"|----------|------|\\\"],[57,\\\"| 🍎 **Mac** (Apple Silicon) | [Download DMG (M1/M2/M3/M4)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\"],[58,\\\"| 💻 **Mac** (Intel) | [Download DMG (x64)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\"],[59,\\\"| 📱 **iOS** (iPhone/iPad) | [TestFlight](./ios/README.md) *(NEW!)* |\\\"],[60,\\\"\\\"],[61,\\\"✅ Signed & notarized by Apple → no scary warnings.\\\"],[62,\\\"\\\"],[63,\\\"---\\\"],[64,\\\"\\\"],[65,\\\"## Jarvis vs $700M startups\\\"],[66,\\\"\\\"],[67,\\\"| | **Jarvis** | The $700M one |\\\"],[68,\\\"|---|:---:|:---:|\\\"],[69,\\\"| 💰 Price | **Free forever** | $10–24/month |\\\"],[70,\\\"| 🔇 Offline / Local | **Yes (Whisper + Parakeet)** | No |\\\"],[71,\\\"| 🔓 Open Source | **Yes (MIT)** | No |\\\"],[72,\\\"| 📡 Telemetry | **None** | ??? |\\\"],[73,\\\"| 👨‍💻 Built by | **1 guy at 2am** | VC money |\\\"],[74,\\\"\\\"],[75,\\\"---\\\"],[76,\\\"\\\"]],\\\"next_start\\\":77,\\\"omissions\\\":[],\\\"omitted_cards\\\":1,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":53,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"8a6b8f3fe0e74f191d96b326658d791dbf3357128b7a0de0be4d91a950d295cb\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 92\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.260f42e2b8c3e702\\\",\\\"documented\\\",\\\"\\\",92,92,92,96],[\\\"N3.f067d079c72e3884\\\",\\\"documented\\\",\\\"\\\",94,94,92,98],[\\\"N3.dacce60f3f411225\\\",\\\"documented\\\",\\\"\\\",96,99,94,101],[\\\"N3.86748dc6dbf846f0\\\",\\\"documented\\\",\\\"\\\",100,100,97,104],[\\\"N3.abd21bd166c03dda\\\",\\\"documented\\\",\\\"\\\",102,105,100,107],[\\\"N3.66267e8ede754c22\\\",\\\"documented\\\",\\\"\\\",106,107,103,110],[\\\"N3.7e5e9183e4df7deb\\\",\\\"documented\\\",\\\"\\\",109,109,106,113],[\\\"N3.6b85224b8b6aaa4d\\\",\\\"documented\\\",\\\"\\\",111,114,109,115]],\\\"end\\\":115,\\\"lines\\\":[[92,\\\"## 🦙 Ollama (Local LLM) Support\\\"],[93,\\\"\\\"],[94,\\\"Jarvis now supports running any LLM locally via Ollama. It's fast, private, and free.\\\"],[95,\\\"\\\"],[96,\\\"1.  **Install Ollama:** [Download here](https://ollama.com)\\\"],[97,\\\"2.  **Pull a model:**\\\"],[98,\\\"    ```bash\\\"],[99,\\\"    # LFM2 (optimized for speed)\\\"],[100,\\\"    ollama pull sam860/LFM2:1.2b\\\"],[101,\\\"\\\"],[102,\\\"    # Llama 3 (standard)\\\"],[103,\\\"    ollama pull llama3\\\"],[104,\\\"    ```\\\"],[105,\\\"3.  **Enable in Jarvis:**\\\"],[106,\\\"    - Settings → AI Models → Enable **Use Ollama**\\\"],[107,\\\"    - Select your model from the dropdown (Jarvis auto-detects them!)\\\"],[108,\\\"\\\"],[109,\\\"### ⚡ Performance Note\\\"],[110,\\\"\\\"],[111,\\\"Running models locally depends heavily on your hardware.\\\"],[112,\\\"- **Enabled AI Post-Processing:** Adds ~1-3s latency on typical M1/M2 chips.\\\"],[113,\\\"- **Disabled AI Post-Processing:** Instant transcription.\\\"],[114,\\\"- **High-End Hardware:** M1/M2/M3 Max/Ultra chips are nearly instant.\\\"],[115,\\\"\\\"]],\\\"next_start\\\":116,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":92,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"6e084b175f2f63074441acb8ac268c0b992452b9d417d859caddcfc270c54a14\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 121\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.9c87bdb5b1367eb7\\\",\\\"documented\\\",\\\"\\\",121,121,121,125],[\\\"N3.64435b851fe8d92c\\\",\\\"documented\\\",\\\"\\\",123,126,121,128],[\\\"N3.b0e22ea229562974\\\",\\\"documented\\\",\\\"\\\",127,127,124,131],[\\\"N3.fe58f310b5641fdd\\\",\\\"documented\\\",\\\"\\\",129,129,126,133],[\\\"N3.e6b2f33a172ad141\\\",\\\"documented\\\",\\\"\\\",131,131,128,135],[\\\"N3.18de619c9983b77f\\\",\\\"documented\\\",\\\"\\\",133,136,131,138],[\\\"N3.b6770c01e6097f74\\\",\\\"documented\\\",\\\"\\\",137,137,134,141],[\\\"N3.72d73ee9c565267a\\\",\\\"documented\\\",\\\"\\\",139,139,136,143]],\\\"end\\\":144,\\\"lines\\\":[[121,\\\"## Keyboard shortcuts\\\"],[122,\\\"\\\"],[123,\\\"| Shortcut | What it does |\\\"],[124,\\\"|----------|--------------|\\\"],[125,\\\"| `Fn` (hold) | Start/stop recording |\\\"],[126,\\\"| `Fn` (double-tap) | Toggle hands-free mode |\\\"],[127,\\\"| `Escape` | Cancel recording |\\\"],[128,\\\"\\\"],[129,\\\"---\\\"],[130,\\\"\\\"],[131,\\\"## Build from source\\\"],[132,\\\"\\\"],[133,\\\"```bash\\\"],[134,\\\"git clone https://github.com/akshayaggarwal99/jarvis-ai-assistant.git\\\"],[135,\\\"cd jarvis-ai-assistant\\\"],[136,\\\"npm install && npm run build && npm run dev\\\"],[137,\\\"```\\\"],[138,\\\"\\\"],[139,\\\"Requires Node.js 18+, macOS 10.13+, Xcode CLI tools.\\\"],[140,\\\"\\\"],[141,\\\"---\\\"],[142,\\\"\\\"],[143,\\\"## Roadmap (help me choose!)\\\"],[144,\\\"\\\"]],\\\"next_start\\\":145,\\\"omissions\\\":[],\\\"omitted_cards\\\":2,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":121,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"828c359eba28a8932c325bb24108c795db513dc38be6d0c2c2b630d17040d7ee\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S2\\\",\\n    \\\"start_line\\\": 20\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.5686d551ddbb0d67\\\",\\\"code\\\",\\\"AgentManager\\\",20,20,20,24],[\\\"N3.448ee6435029ea8b\\\",\\\"code\\\",\\\"Logger.debug\\\",31,31,28,35],[\\\"N3.a220ed7fd7d2c0d8\\\",\\\"limitation\\\",\\\"\\\",39,39,36,43],[\\\"N3.30911dd511c3cee5\\\",\\\"code\\\",\\\"console.log\\\",42,42,39,43],[\\\"N3.c8d2200287789696\\\",\\\"code\\\",\\\"Logger.info\\\",43,43,40,43]],\\\"end\\\":43,\\\"lines\\\":[[20,\\\"      AgentManager.instance = new AgentManager();\\\"],[21,\\\"    }\\\"],[22,\\\"    return AgentManager.instance;\\\"],[23,\\\"  }\\\"],[24,\\\"\\\"],[25,\\\"  async initialize(\\\"],[26,\\\"    openaiKey: string | undefined,\\\"],[27,\\\"    geminiKey?: string,\\\"],[28,\\\"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }\\\"],[29,\\\"  ): Promise<void> {\\\"],[30,\\\"    if (this.isInitialized) {\\\"],[31,\\\"      Logger.debug('🤖 Agent already initialized, skipping...');\\\"],[32,\\\"      return;\\\"],[33,\\\"    }\\\"],[34,\\\"\\\"],[35,\\\"    try {\\\"],[36,\\\"      let provider: LLMProvider | null = null;\\\"],[37,\\\"\\\"],[38,\\\"      // Priority: Ollama (currently only fully implemented provider)\\\"],[39,\\\"      // TODO: Add OpenAI and Gemini providers when implemented\\\"],[40,\\\"\\\"],[41,\\\"      if (ollamaSettings?.useOllama) {\\\"],[42,\\\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\\\"],[43,\\\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\"]],\\\"next_start\\\":44,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S2\\\",\\\"start\\\":20,\\\"total_lines\\\":90,\\\"v\\\":3,\\\"view_id\\\":\\\"219a2639d55752db1c348fbb47373e919340149dd028a1418907a6894829ee9e\\\"}\",\"role\":\"user\"}],\"model\":\"qwen3-8b-uncensored\",\"options\":{\"num_ctx\":16384,\"num_predict\":256,\"temperature\":0},\"shift\":false,\"stream\":false,\"think\":false,\"tools\":[],\"truncate\":false}","generation":6,"hashes":{"entity