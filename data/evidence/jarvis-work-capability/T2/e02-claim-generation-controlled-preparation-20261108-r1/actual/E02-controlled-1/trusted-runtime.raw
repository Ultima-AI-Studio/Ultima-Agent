\"\\\\\\\"],[65,\\\\\\\"## Jarvis vs $700M startups\\\\\\\"],[66,\\\\\\\"\\\\\\\"],[67,\\\\\\\"| | **Jarvis** | The $700M one |\\\\\\\"],[68,\\\\\\\"|---|:---:|:---:|\\\\\\\"],[69,\\\\\\\"| 💰 Price | **Free forever** | $10–24/month |\\\\\\\"],[70,\\\\\\\"| 🔇 Offline / Local | **Yes (Whisper + Parakeet)** | No |\\\\\\\"],[71,\\\\\\\"| 🔓 Open Source | **Yes (MIT)** | No |\\\\\\\"],[72,\\\\\\\"| 📡 Telemetry | **None** | ??? |\\\\\\\"],[73,\\\\\\\"| 👨‍💻 Built by | **1 guy at 2am** | VC money |\\\\\\\"],[74,\\\\\\\"\\\\\\\"],[75,\\\\\\\"---\\\\\\\"],[76,\\\\\\\"\\\\\\\"]],\\\\\\\"next_start\\\\\\\":77,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":1,\\\\\\\"source_id\\\\\\\":\\\\\\\"S1\\\\\\\",\\\\\\\"start\\\\\\\":53,\\\\\\\"total_lines\\\\\\\":205,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"8a6b8f3fe0e74f191d96b326658d791dbf3357128b7a0de0be4d91a950d295cb\\\\\\\"}\\\",\\\"success\\\":true,\\\"tool\\\":\\\"ultima_work_research_inspect\\\"},\\\"timestamp\\\":1794111148.3844936,\\\"type\\\":\\\"tool_call_end\\\"}\",\"{\\\"data\\\":{\\\"agent\\\":\\\"native_react\\\",\\\"arguments\\\":{\\\"source_id\\\":\\\"S1\\\",\\\"start_line\\\":92},\\\"tool\\\":\\\"ultima_work_research_inspect\\\"},\\\"timestamp\\\":1794111149.178607,\\\"type\\\":\\\"tool_call_start\\\"}\",\"{\\\"data\\\":{\\\"agent\\\":\\\"native_react\\\",\\\"latency\\\":0.03445839881896973,\\\"metadata\\\":{\\\"adapter_uuid\\\":\\\"aaec3268-4630-47ec-851c-b7bd679137c0\\\",\\\"arguments\\\":{\\\"source_id\\\":\\\"S1\\\",\\\"start_line\\\":92},\\\"binding\\\":[\\\"b275da01-54b8-4173-9eed-69af6ebc577c\\\",\\\"f04076d9-8241-4b27-8d51-f53fae6c229a\\\",\\\"1d0a6ed0-90c3-4a31-8d57-4d592bf1e5a4\\\"],\\\"dispatch_uuid\\\":\\\"2714eff0-e69d-4213-b1b2-c24e571f7537\\\",\\\"generation\\\":3,\\\"seq\\\":3},\\\"result\\\":\\\"{\\\\\\\"cards\\\\\\\":[[\\\\\\\"N3.260f42e2b8c3e702\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",92,92,92,96],[\\\\\\\"N3.f067d079c72e3884\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",94,94,92,98],[\\\\\\\"N3.dacce60f3f411225\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",96,99,94,101],[\\\\\\\"N3.86748dc6dbf846f0\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",100,100,97,104],[\\\\\\\"N3.abd21bd166c03dda\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",102,105,100,107],[\\\\\\\"N3.66267e8ede754c22\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",106,107,103,110],[\\\\\\\"N3.7e5e9183e4df7deb\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",109,109,106,113],[\\\\\\\"N3.6b85224b8b6aaa4d\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",111,114,109,115]],\\\\\\\"end\\\\\\\":115,\\\\\\\"lines\\\\\\\":[[92,\\\\\\\"## 🦙 Ollama (Local LLM) Support\\\\\\\"],[93,\\\\\\\"\\\\\\\"],[94,\\\\\\\"Jarvis now supports running any LLM locally via Ollama. It's fast, private, and free.\\\\\\\"],[95,\\\\\\\"\\\\\\\"],[96,\\\\\\\"1.  **Install Ollama:** [Download here](https://ollama.com)\\\\\\\"],[97,\\\\\\\"2.  **Pull a model:**\\\\\\\"],[98,\\\\\\\"    ```bash\\\\\\\"],[99,\\\\\\\"    # LFM2 (optimized for speed)\\\\\\\"],[100,\\\\\\\"    ollama pull sam860/LFM2:1.2b\\\\\\\"],[101,\\\\\\\"\\\\\\\"],[102,\\\\\\\"    # Llama 3 (standard)\\\\\\\"],[103,\\\\\\\"    ollama pull llama3\\\\\\\"],[104,\\\\\\\"    ```\\\\\\\"],[105,\\\\\\\"3.  **Enable in Jarvis:**\\\\\\\"],[106,\\\\\\\"    - Settings → AI Models → Enable **Use Ollama**\\\\\\\"],[107,\\\\\\\"    - Select your model from the dropdown (Jarvis auto-detects them!)\\\\\\\"],[108,\\\\\\\"\\\\\\\"],[109,\\\\\\\"### ⚡ Performance Note\\\\\\\"],[110,\\\\\\\"\\\\\\\"],[111,\\\\\\\"Running models locally depends heavily on your hardware.\\\\\\\"],[112,\\\\\\\"- **Enabled AI Post-Processing:** Adds ~1-3s latency on typical M1/M2 chips.\\\\\\\"],[113,\\\\\\\"- **Disabled AI Post-Processing:** Instant transcription.\\\\\\\"],[114,\\\\\\\"- **High-End Hardware:** M1/M2/M3 Max/Ultra chips are nearly instant.\\\\\\\"],[115,\\\\\\\"\\\\\\\"]],\\\\\\\"next_start\\\\\\\":116,\\\\\\\"omissions\\\