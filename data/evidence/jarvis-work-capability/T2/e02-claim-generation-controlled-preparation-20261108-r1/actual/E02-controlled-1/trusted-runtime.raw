transcription.\\\"],[114,\\\"- **High-End Hardware:** M1/M2/M3 Max/Ultra chips are nearly instant.\\\"],[115,\\\"\\\"]],\\\"next_start\\\":116,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":92,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"6e084b175f2f63074441acb8ac268c0b992452b9d417d859caddcfc270c54a14\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S1\\\",\\n    \\\"start_line\\\": 121\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.9c87bdb5b1367eb7\\\",\\\"documented\\\",\\\"\\\",121,121,121,125],[\\\"N3.64435b851fe8d92c\\\",\\\"documented\\\",\\\"\\\",123,126,121,128],[\\\"N3.b0e22ea229562974\\\",\\\"documented\\\",\\\"\\\",127,127,124,131],[\\\"N3.fe58f310b5641fdd\\\",\\\"documented\\\",\\\"\\\",129,129,126,133],[\\\"N3.e6b2f33a172ad141\\\",\\\"documented\\\",\\\"\\\",131,131,128,135],[\\\"N3.18de619c9983b77f\\\",\\\"documented\\\",\\\"\\\",133,136,131,138],[\\\"N3.b6770c01e6097f74\\\",\\\"documented\\\",\\\"\\\",137,137,134,141],[\\\"N3.72d73ee9c565267a\\\",\\\"documented\\\",\\\"\\\",139,139,136,143]],\\\"end\\\":144,\\\"lines\\\":[[121,\\\"## Keyboard shortcuts\\\"],[122,\\\"\\\"],[123,\\\"| Shortcut | What it does |\\\"],[124,\\\"|----------|--------------|\\\"],[125,\\\"| `Fn` (hold) | Start/stop recording |\\\"],[126,\\\"| `Fn` (double-tap) | Toggle hands-free mode |\\\"],[127,\\\"| `Escape` | Cancel recording |\\\"],[128,\\\"\\\"],[129,\\\"---\\\"],[130,\\\"\\\"],[131,\\\"## Build from source\\\"],[132,\\\"\\\"],[133,\\\"```bash\\\"],[134,\\\"git clone https://github.com/akshayaggarwal99/jarvis-ai-assistant.git\\\"],[135,\\\"cd jarvis-ai-assistant\\\"],[136,\\\"npm install && npm run build && npm run dev\\\"],[137,\\\"```\\\"],[138,\\\"\\\"],[139,\\\"Requires Node.js 18+, macOS 10.13+, Xcode CLI tools.\\\"],[140,\\\"\\\"],[141,\\\"---\\\"],[142,\\\"\\\"],[143,\\\"## Roadmap (help me choose!)\\\"],[144,\\\"\\\"]],\\\"next_start\\\":145,\\\"omissions\\\":[],\\\"omitted_cards\\\":2,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":121,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"828c359eba28a8932c325bb24108c795db513dc38be6d0c2c2b630d17040d7ee\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S2\\\",\\n    \\\"start_line\\\": 20\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.5686d551ddbb0d67\\\",\\\"code\\\",\\\"AgentManager\\\",20,20,20,24],[\\\"N3.448ee6435029ea8b\\\",\\\"code\\\",\\\"Logger.debug\\\",31,31,28,35],[\\\"N3.a220ed7fd7d2c0d8\\\",\\\"limitation\\\",\\\"\\\",39,39,36,43],[\\\"N3.30911dd511c3cee5\\\",\\\"code\\\",\\\"console.log\\\",42,42,39,43],[\\\"N3.c8d2200287789696\\\",\\\"code\\\",\\\"Logger.info\\\",43,43,40,43]],\\\"end\\\":43,\\\"lines\\\":[[20,\\\"      AgentManager.instance = new AgentManager();\\\"],[21,\\\"    }\\\"],[22,\\\"    return AgentManager.instance;\\\"],[23,\\\"  }\\\"],[24,\\\"\\\"],[25,\\\"  async initialize(\\\"],[26,\\\"    openaiKey: string | undefined,\\\"],[27,\\\"    geminiKey?: string,\\\"],[28,\\\"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }\\\"],[29,\\\"  ): Promise<void> {\\\"],[30,\\\"    if (this.isInitialized) {\\\"],[31,\\\"      Logger.debug('🤖 Agent already initialized, skipping...');\\\"],[32,\\\"      return;\\\"],[33,\\\"    }\\\"],[34,\\\"\\\"],[35,\\\"    try {\\\"],[36,\\\"      let provider: LLMProvider | null = null;\\\"],[37,\\\"\\\"],[38,\\\"      // Priority: Ollama (currently only fully implemented provider)\\\"],[39,\\\"      // TODO: Add OpenAI and Gemini providers when implemented\\\"],[40,\\\"\\\"],[41,\\\"      if (ollamaSettings?.useOllama) {\\\"],[42,\\\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\\\"],[43,\\\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\"]],\\\"next_start\\\":44,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S2\\\",\\\"start\\\":20,\\\"total_lines\\\":90,\\\"v\\\":3,\\\"view_id\\\":\\\"219a2639d55752db1c348fbb47373e919340149dd028a1418907a6894829ee9e\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S3\\\",\\n    \\\"start_line\\\": 25\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.f01f2b05203a653b\\\",\\\"code\\\",\\\"Logger.info\\\",25,25,25,29],[\\\"N3.871ee2b54f993e3d\\\",\\\"code\\\",\\\"Date.now\\\",37,37,34,41],[\\\"N3.ff77fbd51b03f00f\\\",\\\"code\\\",\\\"Logger.info\\\",40,40,37,44]],\\\"end\\\":48,\\\"lines\\\":[[25,\\\"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);\\\"],[26,\\\"    }\\\"],[27,\\\"\\\"],[28,\\\"    /**\\\"],[29,\\\"     * Process a user query\\\"],[30,\\\"     * Uses function calling to determine if a tool should be used\\\"],[31,\\\"     */\\\"],[32,\\\"    async processQuery(\\\"],[33,\\\"        query: string,\\\"],[34,\\\"        sessionId?: string,\\\"],[35,\\\"        userContext?: { userId?: string; displayName?: string; email?: string }\\\"],[36,\\\"    ): Promise<string> {\\\"],[37,\\\"        const startTime = Date.now();\\\"],[38,\\\"\\\"],[39,\\\"        try {\\\"],[40,\\\"            Logger.info(`📥 [UnifiedAgent] Processing query: \\\\\\\"${query.substring(0, 50)}...\\\\\\\"`);\\\"],[41,\\\"\\\"],[42,\\\"            // If the provider supports tool calling, use it\\\"],[43,\\\"            if (this.provider.supportsToolCalling()) {\\\"],[44,\\\"                return await this.processWithTools(query, startTime);\\\"],[45,\\\"            }\\\"],[46,\\\"\\\"],[47,\\\"            // Fallback to text generation for providers without tool support\\\"],[48,\\\"            return await this.processTextOnly(query, startTime);\\\"]],\\\"next_start\\\":49,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S3\\\",\\\"start\\\":25,\\\"total_lines\\\":110,\\\"v\\\":3,\\\"view_id\\\":\\\"7b929d36a9934d10a2d29f1f2c8a4cb0b6441577118ef1a3a2cfa1f38e403af3\\\"}\",\"role\":\"user\"}],\"strict_schema\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"ultima_work_research_write\"]},\"action_input\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"enum\":[\"research.md\"],\"maxLength\":2048,\"minLength\":1,\"type\":\"string\"},\"sections\":{\"anyOf\":[{\"additionalItems\":false,\"items\":[{\"$ref\":\"#/definitions/research_source_S1\"},{\"$ref\":\"#/definitions/research_source_S2\"},{\"$ref\":\"#/definitions/research_source_S3\"}],\"maxItems\":3,\"minItems\":3,\"type\":\"array\"}],\"maxItems\":5,\"minItems\":3,\"type\":\"array\"},\"title\":{\"maxLength\":200,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"title\",\"sections\"],\"type\":\"object\"}},\"required\":[\"action\",\"action_input\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"final_answer\":{\"enum\":[\"本次研究未交付。\"],\"maxLength\":1000,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"final_answer\"],\"type\":\"object\"}],\"definitions\":{\"research_source_S1\":{\"additionalProperties\":false,\"properties\":{\"facts\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"claim\":{\"maxLength\":2000,\"minLength\":1,\"type\":\"string\"},\"evidence_id\":{\"enum\":[\"N3.0169b70723c8a1e9\",\"N3.0c514aa47434938b\",\"N3.18de619c9983b77f\",\"N3.1d875d938b3ff02b\",\"N3.260f42e2b8c3e702\",\"N3.28d5a175f0153d3a\",\"N3.2964bfdba5189bec\",\"N3.2b97d4feb2b01dff\",\"N3.2cb5219edd135f44\",\"N3.404239faf4ada9c7\",\"N3.540a9d7be41a4cdf\",\"N3.64435b851fe8d92c\",\"N3.66267e8ede754c22\",\"N3.6b85224b8b6aaa4d\",\"N3.72d73ee9c565267a\",\"N3.7d926264e5