\\\\\\\"end\\\\\\\":144,\\\\\\\"lines\\\\\\\":[[121,\\\\\\\"## Keyboard shortcuts\\\\\\\"],[122,\\\\\\\"\\\\\\\"],[123,\\\\\\\"| Shortcut | What it does |\\\\\\\"],[124,\\\\\\\"|----------|--------------|\\\\\\\"],[125,\\\\\\\"| `Fn` (hold) | Start/stop recording |\\\\\\\"],[126,\\\\\\\"| `Fn` (double-tap) | Toggle hands-free mode |\\\\\\\"],[127,\\\\\\\"| `Escape` | Cancel recording |\\\\\\\"],[128,\\\\\\\"\\\\\\\"],[129,\\\\\\\"---\\\\\\\"],[130,\\\\\\\"\\\\\\\"],[131,\\\\\\\"## Build from source\\\\\\\"],[132,\\\\\\\"\\\\\\\"],[133,\\\\\\\"```bash\\\\\\\"],[134,\\\\\\\"git clone https://github.com/akshayaggarwal99/jarvis-ai-assistant.git\\\\\\\"],[135,\\\\\\\"cd jarvis-ai-assistant\\\\\\\"],[136,\\\\\\\"npm install && npm run build && npm run dev\\\\\\\"],[137,\\\\\\\"```\\\\\\\"],[138,\\\\\\\"\\\\\\\"],[139,\\\\\\\"Requires Node.js 18+, macOS 10.13+, Xcode CLI tools.\\\\\\\"],[140,\\\\\\\"\\\\\\\"],[141,\\\\\\\"---\\\\\\\"],[142,\\\\\\\"\\\\\\\"],[143,\\\\\\\"## Roadmap (help me choose!)\\\\\\\"],[144,\\\\\\\"\\\\\\\"]],\\\\\\\"next_start\\\\\\\":145,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":2,\\\\\\\"source_id\\\\\\\":\\\\\\\"S1\\\\\\\",\\\\\\\"start\\\\\\\":121,\\\\\\\"total_lines\\\\\\\":205,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"828c359eba28a8932c325bb24108c795db513dc38be6d0c2c2b630d17040d7ee\\\\\\\"}\\\",\\\"success\\\":true,\\\"tool\\\":\\\"ultima_work_research_inspect\\\"},\\\"timestamp\\\":1794111150.0287738,\\\"type\\\":\\\"tool_call_end\\\"}\",\"{\\\"data\\\":{\\\"agent\\\":\\\"native_react\\\",\\\"arguments\\\":{\\\"source_id\\\":\\\"S2\\\",\\\"start_line\\\":20},\\\"tool\\\":\\\"ultima_work_research_inspect\\\"},\\\"timestamp\\\":1794111150.769884,\\\"type\\\":\\\"tool_call_start\\\"}\",\"{\\\"data\\\":{\\\"agent\\\":\\\"native_react\\\",\\\"latency\\\":0.006467580795288086,\\\"metadata\\\":{\\\"adapter_uuid\\\":\\\"8dc1fdfc-a9fe-4fd5-8755-203b7cf98dfd\\\",\\\"arguments\\\":{\\\"source_id\\\":\\\"S2\\\",\\\"start_line\\\