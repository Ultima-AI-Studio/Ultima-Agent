{"binding":["b275da01-54b8-4173-9eed-69af6ebc577c","f04076d9-8241-4b27-8d51-f53fae6c229a","1d0a6ed0-90c3-4a31-8d57-4d592bf1e5a4"],"clock_domain":"work_tools.monotonic;ledger-sequence-v1","events":["{\"data\":{\"agent\":\"native_react\",\"arguments\":{\"source_id\":\"S1\",\"start_line\":26},\"tool\":\"ultima_work_research_inspect\"},\"timestamp\":1794111147.53546,\"type\":\"tool_call_start\"}","{\"data\":{\"agent\":\"native_react\",\"latency\":0.005694389343261719,\"metadata\":{\"adapter_uuid\":\"1fca6042-2b79-451c-b6aa-22cb41349b44\",\"arguments\":{\"source_id\":\"S1\",\"start_line\":26},\"binding\":[\"b275da01-54b8-4173-9eed-69af6ebc577c\",\"f04076d9-8241-4b27-8d51-f53fae6c229a\",\"1d0a6ed0-90c3-4a31-8d57-4d592bf1e5a4\"],\"dispatch_uuid\":\"41e06b05-2d93-4dc0-9a05-690200080542\",\"generation\":1,\"seq\":1},\"result\":\"{\\\"cards\\\":[[\\\"N3.2964bfdba5189bec\\\",\\\"documented\\\",\\\"\\\",26,26,26,30],[\\\"N3.404239faf4ada9c7\\\",\\\"documented\\\",\\\"\\\",28,29,26,32],[\\\"N3.2cb5219edd135f44\\\",\\\"documented\\\",\\\"\\\",31,32,28,35],[\\\"N3.7d926264e5f7845e\\\",\\\"documented\\\",\\\"\\\",34,34,31,38],[\\\"N3.7e68a47ac05ad2f2\\\",\\\"documented\\\",\\\"\\\",36,36,33,40],[\\\"N3.8b3efd3e1e79f38f\\\",\\\"documented\\\",\\\"\\\",38,38,35,42],[\\\"N3.540a9d7be41a4cdf\\\",\\\"documented\\\",\\\"\\\",40,43,38,45],[\\\"N3.2b97d4feb2b01dff\\\",\\\"documented\\\",\\\"\\\",44,47,42,49]],\\\"end\\\":49,\\\"lines\\\":[[26,\\\"## The (short) story\\\"],[27,\\\"\\\"],[28,\\\"Wispr Flow raised **$81 million** to build a voice dictation app.  \\\"],[29,\\\"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it.\\\"],[30,\\\"\\\"],[31,\\\"That's it.  \\\"],[32,\\\"No funding. No team. Just one stubborn developer who hates subscriptions.\\\"],[33,\\\"\\\"],[34,\\\"This is what open source is supposed to be.\\\"],[35,\\\"\\\"],[36,\\\"---\\\"],[37,\\\"\\\"],[38,\\\"## Why people actually use it\\\"],[39,\\\"\\\"],[40,\\\"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**\\\"],[41,\\\"- Removes \\\\\\\"um\\\\\\\", \\\\\\\"like\\\\\\\", all fillers automatically\\\"],[42,\\\"- Fixes grammar, can rephrase, bullet-point, or even generate text\\\"],[43,\\\"- Tiny actions already work (\\\\\\\"open YouTube\\\\\\\", \\\\\\\"set 5-min timer\\\\\\\")\\\"],[44,\\\"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant.\\\"],[45,\\\"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)\\\"],[46,\\\"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)\\\"],[47,\\\"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`\\\"],[48,\\\"\\\"],[49,\\\"**Zero tracking. Zero telemetry. Zero bullshit.**\\\"]],\\\"next_start\\\":50,\\\"omissions\\\":[],\\\"omitted_cards\\\":1,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":26,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"d070921d652aa13be140685796a9f1154eb270f333deb43f3ae9fad96b2b9ef0\\\"}\",\"success\":true,\"tool\":\"ultima_work_research_inspect\"},\"timestamp\":1794111147.5427184,\"type\":\"tool_call_end\"}","{\"data\":{\"agent\":\"native_react\",\"arguments\":{\"source_id\":\"S1\",\"start_line\":53},\"tool\":\"ultima_work_research_inspect\"},\"timestamp\":1794111148.378277,\"type\":\"tool_call_start\"}","{\"data\":{\"agent\":\"native_react\",\"latency\":0.004677534103393555,\"metadata\":{\"adapter_uuid\":\"4523566b-18e0-49db-b287-cb91f3cb430d\",\"arguments\":{\"source_id\":\"S1\",\"start_line\":53},\"binding\":[\"b275da01-54b8-4173-9eed-69af6ebc577c\",\"f04076d9-8241-4b27-8d51-f53fae6c229a\",\"1d0a6ed0-90c3-4a31-8d57-4d592bf1e5a4\"],\"dispatch_uuid\":\"fce377d5-6645-46fd-9c3b-384e6a14ea4c\",\"generation\":2,\"seq\":2},\"result\":\"{\\\"cards\\\":[[\\\"N3.28d5a175f0153d3a\\\",\\\"documented\\\",\\\"\\\",53,53,53,57],[\\\"N3.0169b70723c8a1e9\\\",\\\"documented\\\",\\\"\\\",55,58,53,60],[\\\"N3.0c514aa47434938b\\\",\\\"documented\\\",\\\"\\\",59,59,56,63],[\\\"N3.9a12680d830ffa32\\\",\\\"documented\\\",\\\"\\\",61,61,58,65],[\\\"N3.958ed26394fea0be\\\",\\\"documented\\\",\\\"\\\",63,63,60,67],[\\\"N3.1d875d938b3ff02b\\\",\\\"documented\\\",\\\"\\\",65,65,62,69],[\\\"N3.c8a9553e2c1c77cc\\\",\\\"documented\\\",\\\"\\\",67,70,65,72],[\\\"N3.b940d4c846822f16\\\",\\\"documented\\\",\\\"\\\",71,73,69,76]],\\\"end\\\":76,\\\"lines\\\":[[53,\\\"## Download\\\"],[54,\\\"\\\"],[55,\\\"| Platform | Link |\\\"],[56,\\\"|----------|------|\\\"],[57,\\\"| 🍎 **Mac** (Apple Silicon) | [Download DMG (M1/M2/M3/M4)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\"],[58,\\\"| 💻 **Mac** (Intel) | [Download DMG (x64)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\"],[59,\\\"| 📱 **iOS** (iPhone/iPad) | [TestFlight](./ios/README.md) *(NEW!)* |\\\"],[60,\\\"\\\"],[61,\\\"✅ Signed & notarized by Apple → no scary warnings.\\\"],[62,\\\"\\\"],[63,\\\"---\\\"],[64,\\\"\\\"],[65,\\\"## Jarvis vs $700M startups\\\"],[66,\\\"\\\"],[67,\\\"| | **Jarvis** | The $700M one |\\\"],[68,\\\"|---|:---:|:---:|\\\"],[69,\\\"| 💰 Price | **Free forever** | $10–24/month |\\\"],[70,\\\"| 🔇 Offline / Local | **Yes (Whisper + Parakeet)** | No |\\\"],[71,\\\"| 🔓 Open Source | **Yes (MIT)** | No |\\\"],[72,\\\"| 📡 Telemetry | **None** | ??? |\\\"],[73,\\\"| 👨‍💻 Built by | **1 guy at 2am** | VC money |\\\"],[74,\\\"\\\"],[75,\\\"---\\\"],[76,\\\"\\\"]],\\\"next_start\\\":77,\\\"omissions\\\":[],\\\"omitted_cards\\\":1,\\\"source_id\\\":\\\"S1\\\",\\\"start\\\":53,\\\"total_lines\\\":205,\\\"v\\\":3,\\\"view_id\\\":\\\"8a6b8f3fe0e74f191d96b326658d791dbf3357128b7a0de0be4d91a950d295cb\\\"}\",\"success\":true,\"tool\":\"ultima_work_research_inspect\"},\"timestamp\":1794111148.3844936,\"type\":\"tool_call_end\"}","{\"data\":{\"agent\":\"native_react\",\"arguments\":{\"source_id\":\"S1\",\"s