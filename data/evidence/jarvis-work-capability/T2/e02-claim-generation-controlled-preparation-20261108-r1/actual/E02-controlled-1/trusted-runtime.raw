\\\\\"suffix\\\\\\\":\\\\\\\".ts\\\\\\\",\\\\\\\"total_lines\\\\\\\":110},{\\\\\\\"available\\\\\\\":true,\\\\\\\"identity\\\\\\\":\\\\\\\"raw.githubusercontent.com/open-jarvis/OpenJarvis/0eb7811df96cf139e6bd6d7fcc9b5cc4ff1418ff/src/openjarvis/agents/native_react.py\\\\\\\",\\\\\\\"landmarks\\\\\\\":[[61,61,\\\\\\\"\\\\\\\"],[96,96,\\\\\\\"value.strip\\\\\\\"],[175,175,\\\\\\\"text.strip\\\\\\\"],[215,219,\\\\\\\"re.search\\\\\\\"],[265,265,\\\\\\\"messages.insert\\\\\\\"],[291,291,\\\\\\\"self._emit_turn_end\\\\\\\"],[337,340,\\\\\\\"self._loop_guard.check_call\\\\\\\"],[360,364,\\\\\\\"self._max_turns_result\\\\\\\"]],\\\\\\\"reason\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"source_id\\\\\\\":\\\\\\\"S4\\\\\\\",\\\\\\\"suffix\\\\\\\":\\\\\\\".py\\\\\\\",\\\\\\\"total_lines\\\\\\\":367}]\\\",\\\"role\\\":\\\"user\\\"},{\\\"content\\\":\\\"{\\\\n  \\\\\\\"action\\\\\\\": \\\\\\\"ultima_work_research_inspect\\\\\\\",\\\\n  \\\\\\\"action_input\\\\\\\": {\\\\n    \\\\\\\"source_id\\\\\\\": \\\\\\\"S1\\\\\\\",\\\\n    \\\\\\\"start_line\\\\\\\": 26\\\\n  }\\\\n}\\\",\\\"role\\\":\\\"assistant\\\"},{\\\"content\\\":\\\"Observation: {\\\\\\\"cards\\\\\\\":[[\\\\\\\"N3.2964bfdba5189bec\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",26,26,26,30],[\\\\\\\"N3.404239faf4ada9c7\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",28,29,26,32],[\\\\\\\"N3.2cb5219edd135f44\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",31,32,28,35],[\\\\\\\"N3.7d926264e5f7845e\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",34,34,31,38],[\\\\\\\"N3.7e68a47ac05ad2f2\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",36,36,33,40],[\\\\\\\"N3.8b3efd3e1e79f38f\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",38,38,35,42],[\\\\\\\"N3.540a9d7be41a4cdf\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",40,43,38,45],[\\\\\\\"N3.2b97d4feb2b01dff\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",44,47,42,49]],\\\\\\\"end\\\\\\\":49,\\\\\\\"lines\\\\\\\":[[26,\\\\\\\"## The (short) story\\\\\\\"],[27,\\\\\\\"\\\\\\\"],[28,\\\\\\\"Wispr Flow raised **$81 million** to build a voice dictation app.  \\\\\\\"],[29,\\\\\\\"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it.\\\\\\\"],[30,\\\\\\\"\\\\\\\"],[31,\\\\\\\"That's it.  \\\\\\\"],[32,\\\\\\\"No funding. No team. Just one stubborn developer who hates subscriptions.\\\\\\\"],[33,\\\\\\\"\\\\\\\"],[34,\\\\\\\"This is what open source is supposed to be.\\\\\\\"],[35,\\\\\\\"\\\\\\\"],[36,\\\\\\\"---\\\\\\\"],[37,\\\\\\\"\\\\\\\"],[38,\\\\\\\"## Why people actually use it\\\\\\\"],[39,\\\\\\\"\\\\\\\"],[40,\\\\\\\"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**\\\\\\\"],[41,\\\\\\\"- Removes \\\\\\\\\\\\\\\"um\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"like\\\\\\\\\\\\\\\", all fillers automatically\\\\\\\"],[42,\\\\\\\"- Fixes grammar, can rephrase, bullet-point, or even generate text\\\\\\\"],[43,\\\\\\\"- Tiny actions already work (\\\\\\\\\\\\\\\"open YouTube\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"set 5-min timer\\\\\\\\\\\\\\\")\\\\\\\"],[44,\\\\\\\"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant.\\\\\\\"],[45,\\\\\\\"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)\\\\\\\"],[46,\\\\\\\"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)\\\\\\\"],[47,\\\\\\\"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`\\\\\\\"],[48,\\\\\\\"\\\\\\\"],[49,\\\\\\\"**Zero tracking. Zero telemetry. Zero bullshit.**\\\\\\\"]],\\\\\\\"next_start\\\\\\\":50,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":1,\\\\\\\"source_id\\\\\\\":\\\\\\\"S1\\\\\\\",\\\\\\\"start\\\\\\\":26,\\\\\\\"total_lines\\\\\\\":205,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"d070921d652aa13be140685796a9f1154eb270f333deb43f3ae9fad96b2b9ef0\\\\\\\"}\\\",\\\"role\\\":\\\"user\\\"},{\\\"content\\\":\\\"{\\\\n  \\\\\\\"action\\\\\\\": \\\\\\\"ultima_work_research_inspect\\\\\\\",\\\\n  \\\\\\\"action_input\\\\\\\": {\\\\n    \\\\\\\"source_id\\\\\\\": \\\\\\\"S1\\\\\\\",\\\\n    \\\\\\\"start_line\\\\\\\": 53\\\\n  }\\\\n}\\\",\\\"role\\\":\\\"assistant\\\"},{\\\"content\\\":\\\"Observation: {\\\\\\\"cards\\\\\\\":[[\\\\\\\"N3.28d5a175f0153d3a\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",53,53,53,57],[\\\\\\\"N3.0169b70723c8a1e9\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",55,58,53,60],[\\\\\\\"N3.0c514aa47434938b\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",59,59,56,63],[\\\\\\\"N3.9a12680d830ffa32\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",61,61,58,65],[\\\\\\\"N3.958ed26394fea0be\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",63,63,60,67],[\\\\\\\"N3.1d875d938b3ff02b\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",65,65,62,69],[\\\\\\\"N3.c8a9553e2c1c77cc\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",67,70,65,72],[\\\\\\\"N3.b940d4c846822f16\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",71,73,69,76]],\\\\\\\"end\\\\\\\":76,\\\\\\\"lines\\\\\\\":[[53,\\\\\\\"## Download\\\\\\\"],[54,\\\\\\\"\\\\\\\"],[55,\\\\\\\"| Platform | Link |\\\\\\\"],[56,\\\\\\\"|----------|------|\\\\\\\"],[57,\\\\\\\"| 🍎 **Mac** (Apple Silicon) | [Download DMG (M1/M2/M3/M4)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\\\\\"],[58,\\\\\\\"| 💻 **Mac** (Intel) | [Download DMG (x64)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |\\\\\\\"],[59,\\\\\\\"| 📱 **iOS** (iPhone/iPad) | [TestFlight](./ios/README.md) *(NEW!)* |\\\\\\\"],[60,\\\\\\\"\\\\\\\"],[61,\\\\\\\"✅ Signed & notarized by Apple → no scary warnings.\\\\\\\"],[62,\\\\\\\"\\\\\\\"],[63,\\\\\\\"---\\\\\\\"],[64,\\\\\\\"\\\\\\\"],[65,\\\\\\\"## Jarvis vs $700M startups\\\\\\\"],[66,\\\\\\\"\\\\\\\"],[67,\\\\\\\"| | **Jarvis** | The $700M one |\\\\\\\"],[68,\\\\\\\"|---|:---:|:---:|\\\\\\\"],[69,\\\\\\\"| 💰 Price | **Free forever** | $10–24/month |\\\\\\\"],[70,\\\\\\\"| 🔇 Offline / Local | **Yes (Whisper + Parakeet)** | No |\\\\\\\"],[71,\\\\\\\"| 🔓 Open Source | **Yes (MIT)** | No |\\\\\\\"],[72,\\\\\\\"| 📡 Telemetry | **None** | ??? |\\\\\\\"],[73,\\\\\\\"| 👨‍💻 Built by | **1 guy at 2am** | VC money |\\\\\\\"],[74,\\\\\\\"\\\\\\\"],[75,\\\\\\\"---\\\\\\\"],[76,\\\\\\\"\\\\\\\"]],\\\\\\\"next_start\\\\\\\":77,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":1,\\\\\\\"source_id\\\\\\\":\\\\\\\"S1\\\\\\\",\\\\\\\"start\\\\\\\":53,\\\\\\\"total_lines\\\\\\\":205,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"8a6b8f3fe0e74f191d96b326658d791dbf3357128b7a0de0be4d91a950d295cb\\\\\\\"}\\\",\\\"role\\\":\\\"user\\\"},{\\\"content\\\":\\\"{\\\\n  \\\\\\\"action\\\\\\\": \\\\\\\"ultima_work_research_inspect\\\\\\\",\\\\n  \\\\\\\"action_input\\\\\\\": {\\\\n    \\\\\\\"source_id\\\\\\\": \\\\\\\"S1\\\\\\\",\\\\n    \\\\\\\"start_line\\\\\\\": 92\\\\n  }\\\\n}\\\",\\\"role\\\":\\\"assistant\\\"},{\\\"content\\\":\\\"Observation: {\\\\\\\"cards\\\\\\\":[[\\\\\\\"N3.260f42e2b8c3e702\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",92,92,92,96],[\\\\\\\"N3.f067d079c72e3884\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",94,94,92,98],[\\\\\\\"N3.dacce60f3f411225\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",96,99,94,101],[\\\\\\\"N3.86748dc6dbf846f0\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",100,100,97,104],[\\\\\\\"N3.abd21bd166c03dda\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",102,105,100,107],[\\\\\\\"N3.66267e8ede754c22\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",106,107,103,110],[\\\\\\\"N3.7e5e9183e4df7deb\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",109,109,106,113],[\\\\\\\"N3.6b85224b8b6aaa4d\\\\\\\",\\\\\\\"documented\\\\\\\",\\\\\\\"\\\\\\\",111,114,109,115]],\\\\\\\"end\\\\\\\":115,\\\\\\\"lines\\\\\\\":[[92,\\\\\\\"## 🦙 Ollama (Local LLM) Support\\\\\\\"],[93,\\\\\\\"\\\\\\\"],[94,\\\\\\\"Jarvis now supports running any LLM locally via Ollama. It's fast, private, and free.\\\\\\\"],[95,\\\\\\\"\\\\\\\"],[96,\\\\\\\"1.  **Install Ollama:** [Download here](https://ollama.com)\\\\\\\"],[97,\\\\\\\"2.  **Pull a model:**\\\\\\\"],[98,\\\\\\\"    ```bash\\\\\\\"],[99,\\\\\\\"    # LFM2 (optimized for speed)\\\\\\\"],[100,\\\\\\\"    ollama pull sam860/LFM2:1.2b\\\\\\\"],[101,\\\\\\\"\\\\\\\"],[102,\\\\\\\"    # Llama 3 (standard)\\\\\\\"],[103,\\\\\\\"    ollama pull llama3\\\\\\\"],[104,\\\\\\\"    ```\\\\\\\"],[105,\\\\\\\"3.  **Enable in Jarvis:**\\\\\\\"],[106,\\\\\\\"    - Settings → AI Models → Enable **Use Ollama**\\\\\\\"],[107,\\\\\\\"    - Select your model from the dropdown (Jarvis auto-detects them!)\\\\\\\"],[108,\\\\\\\"\\\\\\\"],[109,\\\\\\\"### ⚡ Performance Note\\\\\\\"],[110,\\\\\\\"\\\\\\\"],[111,\\\\\\\"Running models locally depends heavily on your hardware.\\\\\\\"],[112,\\\\\\\"- **Enabled AI Post-Processing:** Adds ~1-3s latency on typical M1/M2 chips.\\\\\\\"],[113,\\\\\\\"- **Disabled AI Post-Processing:** Instant transcription.\\\\\\\"],[114,\\\\\\\"- **High-End Hardware:** M1/M2/M3 Max/Ultra chips are nearly instant.\\\\\\\"],[115,\\\\\\\"\\\\\\\"]],\\\\\\\"next_start\\\\\\\":116,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":0,\\\\\\\"source_id\\\\\\\":\\\\\\\"S1\\\\\\\",\\\\\\\"start\\\\\\\":92,\\\\\\\"total_lines\\\\\\\":205,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"6e084b175f2f63074441acb8ac268c0b992452b9d417d859caddcfc270c54a14\\\\\\\"}\\\",\\\"role\\\":\\\"user\\\"}],\\\"model\\\":\\\"qwen3-8b-uncensored\\\",\\\"options\\\":{\\\"num_ctx\\\":16384,\\\"num_predict\\\":256,\\\"temperature\\\":0},\\\"shift\\\":false,\\\"stream\\\":false,\\\"think\\\":false,\\\"tools\\\":[],\\\"truncate\\\":false}\",\"generation\":4,\"hashes\":{\"entity\":\"5c28cd4dd67346f98abbfa066c9bc259d2a2a6479e6e86bbb82b8d2d06ebe7de\",\"messages\":\"3aab89474906471a6ab2f5fb8a0d850deb1997617dcfb45901d3808dde9515dd\",\"sampler\":\"