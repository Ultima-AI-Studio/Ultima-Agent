+@pytest.mark.parametrize('name', ['main', 'run_case', 'RootInvocation', 'actual_child_entry', 'inert_child_entry'])
+def test_source13_adapter_has_no_legacy_entry(name):
+    assert not hasattr(binding_adapter(), name)
+
