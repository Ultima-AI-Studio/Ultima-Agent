_id\\\":\\\"S2\\\",\\\"start_line\\\":20}}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.aa02f4572c638738\\\",\\\"code\\\",\\\"AgentManager\\\",20,20,20,24],[\\\"N3.9727cd564eb84ca6\\\",\\\"code\\\",\\\"Logger.debug\\\",31,31,28,35],[\\\"N3.0970db6267d9be57\\\",\\\"limitation\\\",\\\"\\\",39,39,36,43],[\\\"N3.ff6980d9bd904acf\\\",\\\"code\\\",\\\"console.log\\\",42,42,39,43],[\\\"N3.116eef196a6a3140\\\",\\\"code\\\",\\\"Logger.info\\\",43,43,40,43]],\\\"end\\\":43,\\\"lines\\\":[[20,\\\"      AgentManager.instance = new AgentManager();\\\"],[21,\\\"    }\\\"],[22,\\\"    return AgentManager.instance;\\\"],[23,\\\"  }\\\"],[24,\\\"\\\"],[25,\\\"  async initialize(\\\"],[26,\\\"    openaiKey: string | undefined,\\\"],[27,\\\"    geminiKey?: string,\\\"],[28,\\\"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }\\\"],[29,\\\"  ): Promise<void> {\\\"],[30,\\\"    if (this.isInitialized) {\\\"],[31,\\\"      Logger.debug('🤖 Agent already initialized, skipping...');\\\"],[32,\\\"      return;\\\"],[33,\\\"    }\\\"],[34,\\\"\\\"],[35,\\\"    try {\\\"],[36,\\\"      let provider: LLMProvider | null = null;\\\"],[37,\\\"\\\"],[38,\\\"      // Priority: Ollama (currently only fully implemented provider)\\\"],[39,\\\"      // TODO: Add OpenAI and Gemini providers when implemented\\\"],[40,\\\"\\\"],[41,\\\"      if (ollamaSettings?.useOllama) {\\\"],[42,\\\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\\\"],[43,\\\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\"]],\\\"next_start\\\":44,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S2\\\",\\\"start\\\":20,\\\"total_lines\\\":90,\\\"v\\\":3,\\\"view_id\\\":\\\"b0a871301300998ec438c2888deb49d0dcb2f7f5d380efe6aef5737087f53468\\\"}\",\"role\":\"user\"},{\"content\":\"{\\\"action\\\":\\\"ultima_work_research_inspect\\\",\\\"action_input\\\":{\\\"source_id\\\":\\\"S3\\\",\\\"start_line\\\":25}}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.25fc665969a41db5\\\",\\\"code\\\",\\\"Logger.info\\\",25,25,25,29],[\\\"N3.7e96deb53ae06055\\\",\\\"code\\\",\\\"Date.now\\\",37,37,34,41],[\\\"N3.b03728027a351f81\\\",\\\"code\\\",\\\"Logger.info\\\",40,40,37,44]],\\\"end\\\":48,\\\"lines\\\":[[25,\\\"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);\\\"],[26,\\\"    }\\\"],[27,\\\"\\\"],[28,\\\"    /**\\\"],[29,\\\"     * Process a user query\\\"],[30,\\\"     * Uses function calling to determine if a tool should be used\\\"],[31,\\\"     */\\\"],[32,\\\"    async processQuery(\\\"],[33,\\\"        query: string,\\\"],[34,\\\"        sessionId?: string,\\\"],[35,\\\"        userContext?: { userId?: string; displayName?: string; email?: string }\\\"],[36,\\\"    ): Promise<string> {\\\"],[37,\\\"        const startTime = Date.now();\\\"],[38,\\\"\\\"],[39,\\\"        try {\\\"],[40,\\\"            Logger.info(`📥 [UnifiedAgent] Processing query: \\\\\\\"${query.substring(0, 50)}...\\\\\\\"`);\\\"],[41,\\\"\\\"],[42,\\\"            // If the provider supports tool calling, use it\\\"],[43,\\\"            if (this.provider.supportsToolCalling()) {\\\"],[44,\\\"                return await this.processWithTools(query, startTime);\\\"],[45,\\\"            }\\\"],[46,\\\"\\\"],[47,\\\"            // Fallback to text generation for providers without tool support\\\"],[48,\\\"            return await this.processTextOnly(query, startTime);\\\"]],\\\"next_start\\\":49,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S3\\\",\\\"start\\\":25,\\\"total_lines\\\":110,\\\"v\\\":3,\\\"view_id\\\":\\\"4f3f4379481c17836b7bb45126e9786a73e569310ce1db050db65961209342a6\\\"}\",\"role\":\"user\"},{\"content\":\"{\\\"action\\\":\\\"ultima_work_research_inspect\\\",\\\"action_input\\\":{\\\"source_id\\\":\\\"S4\\\"