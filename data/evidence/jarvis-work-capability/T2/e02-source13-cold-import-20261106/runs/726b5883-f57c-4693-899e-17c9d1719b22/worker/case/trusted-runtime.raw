ing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\\\\\"]],\\\\\\\"next_start\\\\\\\":44,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":0,\\\\\\\"source_id\\\\\\\":\\\\\\\"S2\\\\\\\",\\\\\\\"start\\\\\\\":20,\\\\\\\"total_lines\\\\\\\":90,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"b0a871301300998ec438c2888deb49d0dcb2f7f5d380efe6aef5737087f53468\\\\\\\"}\\\",\\\"role\\\":\\\"user\\\"},{\\\"content\\\":\\\"{\\\\\\\"action\\\\\\\":\\\\\\\"ultima_work_research_inspect\\\\\\\",\\\\\\\"action_input\\\\\\\":{\\\\\\\"source_id\\\\\\\":\\\\\\\"S3\\\\\\\",\\\\\\\"start_line\\\\\\\":25}}\\\",\\\"role\\\":\\\"assistant\\\"},{\\\"content\\\":\\\"Observation: {\\\\\\\"cards\\\\\\\":[[\\\\\\\"N3.25fc665969a41db5\\\\\\\",\\\\\\\"code\\\\\\\",\\\\\\\"Logger.info\\\\\\\",25,25,25,29],[\\\\\\\"N3.7e96deb53ae06055\\\\\\\",\\\\\\\"code\\\\\\\",\\\\\\\"Date.now\\\\\\\",37,37,34,41],[\\\\\\\"N3.b03728027a351f81\\\\\\\",\\\\\\\"code\\\\\\\",\\\\\\\"Logger.info\\\\\\\",40,40,37,44]],\\\\\\\"end\\\\\\\":48,\\\\\\\"lines\\\\\\\":[[25,\\\\\\\"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);\\\\\\\"],[26,\\\\\\\"    }\\\\\\\"],[27,\\\\\\\"\\\\\\\"],[28,\\\\\\\"    /**\\\\\\\"],[29,\\\\\\\"     * Process a user query\\\\\\\"],[30,\\\\\\\"     * Uses function calling to determine if a tool should be used\\\\\\\"],[31,\\\\\\\"     */\\\\\\\"],[32,\\\\\\\"    async processQuery(\\\\\\\"],[33,\\\\\\\"        query: string,\\\\\\\"],[34,\\\\\\\"        sessionId?: string,\\\\\\\"],[35,\\\\\\\"        userContext?: { userId?: string; displayName?: string; email?: string }\\\\\\\"],[36,\\\\\\\"    ): Promise<string> {\\\\\\\"],[37,\\\\\\\"        const startTime = Date.now();\\\\\\\"],[38,\\\\\\\"\\\\\\\"],[39,\\\\\\\"        try {\\\\\\\"],[40,\\\\\\\"            Logger.info(`📥 [UnifiedAgent] Processing query: \\\\\\\\\\\\\\\"${query.substring(0, 50)}...\\\\\\\\\\\\\\\"`);\\\\\\\"],[41,\\\\\\