},{"at":"305574.0853685","deadline":"305832.5605013","event_index":7,"kind":"sdk_end","order":51,"seq":4},{"at":"305574.0908838","deadline":"305832.5605013","generation":5,"kind":"generation","order":52},{"at":"305574.0911366","deadline":"305832.5605013","generation":5,"kind":"send","order":53,"receipt_index":12},{"at":"305574.0913167","deadline":"305832.5605013","generation":5,"kind":"return","order":54,"receipt_index":12},{"at":"305574.0914844","deadline":"305832.5605013","generation":5,"kind":"send","order":55,"receipt_index":13},{"at":"305574.0916012","deadline":"305832.5605013","generation":5,"kind":"return","order":56,"receipt_index":13},{"at":"305574.0951854","deadline":"305832.5605013","generation":5,"kind":"send","order":57,"receipt_index":14},{"at":"305574.0962173","deadline":"305832.5605013","generation":5,"kind":"return","order":58,"receipt_index":14},{"at":"305574.1021402","deadline":"305832.5605013","generation":5,"kind":"secured","order":59},{"at":"305574.1021516","deadline":"305832.5605013","kind":"promote","order":60,"seq":4,"wire_hash":"63421de3a20bab175b5f0ec43bd282b7bb2d763f9602220c041db1b91b0875dc"},{"args_hash":"933758774a14c859a272780dcb12b782ae1ad465d9594729f74f75c2ad3f138c","at":"305574.1022097","deadline":"305832.5605013","kind":"expect","name":"ultima_work_research_write","order":61,"seq":5},{"at":"305574.1036086","deadline":"305832.5605013","event_index":8,"kind":"sdk_start","order":62,"seq":5},{"adapter_uuid":"fd7407d5-958e-4232-b7b8-59a606b4d63a","at":"305574.1038174","deadline":"305832.5605013","dispatch_uuid":"3fe4da0a-2fbf-4198-accc-d361a1a3541b","kind":"claim","order":63,"seq":5},{"at":"305574.1380307","deadline":"305832.5605013","kind":"freeze","order":64,"seq":5},{"at":"305574.4362727","deadline":"305832.5605013","file_call_id":"4c7ffce1-1ef0-44f7-ba53-2f52543a9a1b","kind":"intent","order":65,"seq":5},{"at":"305574.4472485","deadline":"305832.5605013","file_call_id":"4c7ffce1-1ef0-44f7-ba53-2f52543a9a1b","kind":"file_end","order":