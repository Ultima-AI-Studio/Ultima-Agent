N3.203ed4f0edfcfbdf\",\"documented\",\"\",18,18,15,22],[\"N3.cf4bfb4b673a14ee\",\"documented\",\"\",20,20,17,24],[\"N3.bae6440d0900e1b5\",\"documented\",\"\",22,22,19,24]],\"end\":24,\"lines\":[[1,\"<p align=\\\"center\\\">\"],[2,\"  <img src=\\\"assets/jarvis-logo.svg\\\" alt=\\\"Jarvis\\\" width=\\\"140\\\"/>\"],[3,\"</p>\"],[4,\"<h1 align=\\\"center\\\">Jarvis AI Assistant</h1>\"],[5,\"<p align=\\\"center\\\"><strong>Hold one key. Speak. Text appears — perfectly.</strong></p>\"],[6,\"<p align=\\\"center\\\">\"],[7,\"  <em>100% open-source • 100% local-capable • 100% free forever</em>\"],[8,\"</p>\"],[9,\"\"],[10,\"<p align=\\\"center\\\">\"],[11,\"  <a href=\\\"https://jarvis.ceo\\\"><img src=\\\"https://img.shields.io/badge/website-jarvis.ceo-0066FF?style=for-the-badge\\\" /></a>\"],[12,\"  <a href=\\\"https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest\\\"><img src=\\\"https://img.shields.io/github/v/release/akshayaggarwal99/jarvis-ai-assistant?style=for-the-badge&logo=apple&label=Download&color=0066FF\\\" /></a>\"],[13,\"  <a href=\\\"https://github.com/akshayaggarwal99/jarvis-ai-assistant/stargazers\\\"><img src=\\\"https://img.shields.io/github/stars/akshayaggarwal99/jarvis-ai-assistant?style=for-the-badge&color=FFD700\\\" /></a>\"],[14,\"</p>\"],[15,\"\"],[16,\"<p align=\\\"center\\\">\"],[17,\"\"],[18,\"https://github.com/user-attachments/assets/763ea6aa-87d5-4e0a-9f05-a2bdaa82f40f\"],[19,\"\"],[20,\"</p>\"],[21,\"\"],[22,\"<p align=\\\"center\\\"><a href=\\\"https://www.youtube.com/watch?v=TnNf300Bbxg\\\">▶ Watch full 2-min demo on YouTube</a></p>\"],[23,\"\"],[24,\"---\"]],\"next_start\":25,\"omissions\":[],\"omitted_cards\":1,\"source_id\":\"S1\",\"start\":1,\"total_lines\":205,\"v\":3,\"view_id\":\"d36ba74c2420495e2e2361303e35497e42a4d9b5aea50c6f4b089da2fc697402\"}","role":"user"},{"content":"{\"action\":\"ultima_work_research_inspect\",\"action_input\":{\"source_id\":\"S2\",\"start_line\":20}}","role":"assistant"},{"content":"Observation: {\"cards\":[[\"N3.0387fcf1b0054632\",\"code\",\"AgentManager\",20,20,20,24],[\"N3.35772ea1fae79997\",\"code\",\"Logger.debug\",31,31,28,35],[\"N3.80437cbf46f0fbff\",\"limitation\",\"\",39,39,36,43],[\"N3.65142fe6748bd3b7\",\"code\",\"console.log\",42,42,39,43],[\"N3.63cb643788427fe4\",\"code\",\"Logger.info\",43,43,40,43]],\"end\":43,\"lines\":[[20,\"      AgentManager.instance = new AgentManager();\"],[21,\"    }\"],[22,\"    return AgentManager.instance;\"],[23,\"  }\"],[24,\"\"],[25,\"  async initialize(\"],[26,\"    openaiKey: string | undefined,\"],[27,\"    geminiKey?: string,\"],[28,\"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }\"],[29,\"  ): Promise<void> {\"],[30,\"    if (this.isInitialized) {\"],[31,\"      Logger.debug('🤖 Agent already initialized, skipping...');\"],[32,\"      return;\"],[33,\"    }\"],[34,\"\"],[35,\"    try {\"],[36,\"      let provider: LLMProvider | null = null;\"],[37,\"\"],[38,\"      // Priority: Ollama (currently only fully implemented provider)\"],[39,\"      // TODO: Add OpenAI and Gemini providers when implemented\"],[40,\"\"],[41,\"      if (ollamaSettings?.useOllama) {\"],[42,\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\"],[43,\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\"]],\"next_start\":44,\"omissions\":[],\"omitted_cards\":0,\"source_id\":\"S2\",\"start\":20,\"total_lines\":90,\"v\":3,\"view_id\":\"c8d335380559d7537ccd89c15ea5c40b38f86b4e526111a520976e70268ccac9\"}","role":"user"},{"content":"{\"action\":\"ultima_work_research_inspect\",\"action_input\":{\"source_id\":\"S3\",\"start_line\":25}}","role":"assistant"},{"content":"Observation: {\"cards\":[[\"N3.2f5667099d7343dd\",\"code\",\"Logger.info\",25,25,25,29],[\"N3.f035c0e446d07b9a\",\"code\",\"Date.now\",37,37,34,41],[\"N3.aa273a1fbf501b46\",\"code\",\"Logger.info\",40,40,37,44]],\"end\":48,\"lines\":[[25,\"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);\"],[26,\"    }\"],[27,\"\"],[28,\"    /**\"],[29,\"     * Process a user query\"],[30,\"     * Uses function calling to determine if a tool should be used\"],[31,\"     */\"],[32,\"    async processQuery(\"],[33,\"        query: string,\"],[34,\"        sessionId?: string,\"],[35,\"        userContext?: { userId?: string; displayName?: string; email?: string }\"],[36,\"    ): Promise<string> {\"],[37,\"        const startTime = Date.now();\"],[38,\"\"],[39,\"        try {\"],[40,\"            Logger.info(`📥 [UnifiedAgent] Processing query: \\\"${query.substring(0, 50)}...\\\"`);\"],[41,\"\"],[42,\"            // If the provider supports tool calling, use it\"],[43,\"            if (this.provider.supportsToolCalling()) {\"],[44,\"                return await this.processWithTools(query, startTime);\"],[45,\"            }\"],[46,\"\"],[47,\"            // Fallback to text generation for providers without tool support\"],[48,\"            return await this.processTextOnly(query, startTime);\"]],\"next_start\":49,\"omissions\":[],\"omitted_cards\":0,\"source_id\":\"S3\",\"start\":25,\"total_lines\":110,\"v\":3,\"view_id\":\"ea74c2d3fff04987e94b2409313d526d44633823c41b5bea6d627b94e770eadd\"}","role":"user"}],"strict_schema":{"anyOf":[{"additionalProperties":false,"properties":{"action":{"enum":["ultima_work_research_inspect"]},"action_input":{"additionalProperties":false,"properties":{"source_id":{"enum":["S1","S2","S3","S4","S5"],"type":"string"},"start_line":{"maximum":1024,"minimum":1,"type":"integer"}},"required":["source_id","start_line"],"type":"object"}},"required":["action","action_input"],"type":"object"},{"additionalProperties":false,"properties":{"action":{"enum":["ultima_work_research_write"]},"action_input":{"additionalProperties":false,"properties":{"path":{"maxLength":2048,"minLength":1,"type":"string"},"sections":{"items":{"additio