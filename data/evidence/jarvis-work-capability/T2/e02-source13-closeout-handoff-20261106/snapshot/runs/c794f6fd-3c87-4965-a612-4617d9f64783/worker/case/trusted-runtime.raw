gger.debug\\\\\\\",31,31,28,35],[\\\\\\\"N3.80437cbf46f0fbff\\\\\\\",\\\\\\\"limitation\\\\\\\",\\\\\\\"\\\\\\\",39,39,36,43],[\\\\\\\"N3.65142fe6748bd3b7\\\\\\\",\\\\\\\"code\\\\\\\",\\\\\\\"console.log\\\\\\\",42,42,39,43],[\\\\\\\"N3.63cb643788427fe4\\\\\\\",\\\\\\\"code\\\\\\\",\\\\\\\"Logger.info\\\\\\\",43,43,40,43]],\\\\\\\"end\\\\\\\":43,\\\\\\\"lines\\\\\\\":[[20,\\\\\\\"      AgentManager.instance = new AgentManager();\\\\\\\"],[21,\\\\\\\"    }\\\\\\\"],[22,\\\\\\\"    return AgentManager.instance;\\\\\\\"],[23,\\\\\\\"  }\\\\\\\"],[24,\\\\\\\"\\\\\\\"],[25,\\\\\\\"  async initialize(\\\\\\\"],[26,\\\\\\\"    openaiKey: string | undefined,\\\\\\\"],[27,\\\\\\\"    geminiKey?: string,\\\\\\\"],[28,\\\\\\\"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }\\\\\\\"],[29,\\\\\\\"  ): Promise<void> {\\\\\\\"],[30,\\\\\\\"    if (this.isInitialized) {\\\\\\\"],[31,\\\\\\\"      Logger.debug('🤖 Agent already initialized, skipping...');\\\\\\\"],[32,\\\\\\\"      return;\\\\\\\"],[33,\\\\\\\"    }\\\\\\\"],[34,\\\\\\\"\\\\\\\"],[35,\\\\\\\"    try {\\\\\\\"],[36,\\\\\\\"      let provider: LLMProvider | null = null;\\\\\\\"],[37,\\\\\\\"\\\\\\\"],[38,\\\\\\\"      // Priority: Ollama (currently only fully implemented provider)\\\\\\\"],[39,\\\\\\\"      // TODO: Add OpenAI and Gemini providers when implemented\\\\\\\"],[40,\\\\\\\"\\\\\\\"],[41,\\\\\\\"      if (ollamaSettings?.useOllama) {\\\\\\\"],[42,\\\\\\\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\\\\\\\"],[43,\\\\\\\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\\\\\"]],\\\\\\\"next_start\\\\\\\":44,\\\\\\\"omissions\\\\\\\":[],\\\\\\\"omitted_cards\\\\\\\":0,\\\\\\\"source_id\\\\\\\":\\\\\\\"S2\\\\\\\",\\\\\\\"start\\\\\\\":20,\\\\\\\"total_lines\\\\\\\":90,\\\\\\\"v\\\\\\\":3,\\\\\\\"view_id\\\\\\\":\\\\\\\"c8d335380559d7537ccd89c15ea5c40b38f86b4e526111a520976e