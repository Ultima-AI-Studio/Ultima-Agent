":"a757f7d3-3c7e-4419-9593-1ed7426f3d26","kind":"file_end","order":66},{"at":"300141.9163606","deadline":"300399.8589962","event_index":9,"kind":"sdk_end","order":67,"seq":5},{"at":"300142.2413603","deadline":"300399.8589962","generation":6,"kind":"generation","order":68},{"at":"300142.2416408","deadline":"300399.8589962","generation":6,"kind":"send","order":69,"receipt_index":15},{"at":"300142.2418086","deadline":"300399.8589962","generation":6,"kind":"return","order":70,"receipt_index":15},{"at":"300142.2419754","deadline":"300399.8589962","generation":6,"kind":"send","order":71,"receipt_index":16},{"at":"300142.2420825","deadline":"300399.8589962","generation":6,"kind":"return","order":72,"receipt_index":16},{"at":"300142.2450162","deadline":"300399.8589962","generation":6,"kind":"send","order":73,"receipt_index":17},{"at":"300142.2460166","deadline":"300399.8589962","generation":6,"kind":"return","order":74,"receipt_index":17},{"at":"300142.2511133","deadline":"300399.8589962","generation":6,"kind":"secured","order":75}],"transport":{"admitted":{"chat":1888,"metadata":2286},"completed":6,"generations":6,"gets":12,"post_bytes":85892,"posts":6,"receipts":[{"admission_error":null,"admitted":22,"downloaded":22,"entity_bytes":0,"entity_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","error":null,"inspected":22,"kind":"metadata","method":"GET","path":"/api/version","peer_bytes":null,"response_sha256":"daac797f978a0cae19be6b37370789f092f91123d9afa5463481633a4cbe33c6","retained":22,"send_reserved":true,"socket_bytes":null,"status":200,"timeout_json":"{\"connect\":25,\"pool\":25,\"read\":25,\"write\":25}"},{"admission_error":null,"admitted":359,"downloaded":359,"entity_bytes":0,"entity_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","error":null,"inspected":359,"kind":"metadata","method":"GET","path":"/api/tags","peer_bytes":null,"response_sha256":"15543e65c72332ba5590dcdc1955c033978a5f001984c965ce26104838565e11","ret