{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "title",
    "sections"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "heading",
          "facts"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "enum": [
              "S1",
              "S2",
              "S3"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}