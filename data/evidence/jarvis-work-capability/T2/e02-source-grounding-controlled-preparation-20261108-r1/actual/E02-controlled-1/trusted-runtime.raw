,\\\"\\\"],[41,\\\"      if (ollamaSettings?.useOllama) {\\\"],[42,\\\"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);\\\"],[43,\\\"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);\\\"]],\\\"next_start\\\":44,\\\"omissions\\\":[],\\\"omitted_cards\\\":0,\\\"source_id\\\":\\\"S2\\\",\\\"start\\\":20,\\\"total_lines\\\":90,\\\"v\\\":3,\\\"view_id\\\":\\\"5196a25eb17dc419b1fc3ffbfa321018d5a8ced4850f48e7f4e0a40d9c8f2236\\\"}\",\"role\":\"user\"},{\"content\":\"{\\n  \\\"action\\\": \\\"ultima_work_research_inspect\\\",\\n  \\\"action_input\\\": {\\n    \\\"source_id\\\": \\\"S3\\\",\\n    \\\"start_line\\\": 25\\n  }\\n}\",\"role\":\"assistant\"},{\"content\":\"Observation: {\\\"cards\\\":[[\\\"N3.567d308b0fc81491\\\",\\\"code\\\",\\\"Logger.info\\\",25,25,25,29],[\\\"N3.30e4c0ec1b0784c9\\\",\\\"code\\\",\\\"Date.now\\\",37,37,34,41],[\\\"N3.a206f8ec0d24591b\\\",\\\"code\\\",\\\"Logger.info\\\",40,40,37,44]],\\\"end\\\":48,\\\"lines\\\":[[25,\\\"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);\\\"],[26,\\\"    }\\\"],[27,\\\"\\\"],[28,\\\"    /**\\\"],[29,\\\"     * Process a user query\\\"],[30,\\\"     * Uses function calling to determine if a tool should be used\\\"],[31,\\\"     */\\\"],[32,\\\"    async processQuery(\\\"],[33,\\\"        query: string,\\\"],[34,\\\"        sessionId?: string,\\\"],[35,\\\"        userContext?: { userId?: string; displayName?: string; email?: string }\\\"],[36,\\\"    ): Promise<string> {\\\"],[37,\\\"        const startTime = Date.now();\\\"],[38,\\\"\\\"],[39,\\\"        try {\\\"],[40,\\\"            Logger.info(`📥 [UnifiedAgent] Processing query: \\\\\\\"${query.substring(0, 50)}...\\\\\\\"`);\\\"],[41,\\\"\\\"],[42,\\\"            // If the provider supports tool calling, use it\\\"],[43,\\\"            if (this.provider.supportsToolCalling()) {\\\"],[44,