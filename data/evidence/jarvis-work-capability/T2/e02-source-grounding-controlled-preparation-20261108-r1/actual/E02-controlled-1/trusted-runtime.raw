\",\"\",26,26,26,30],[\"N3.4bfb1a65cb740e28\",\"documented\",\"\",28,29,26,32],[\"N3.1b876c6a7f2df219\",\"documented\",\"\",31,32,28,35],[\"N3.0d900bd548fb2e7b\",\"documented\",\"\",34,34,31,38],[\"N3.bbf447baa068f16c\",\"documented\",\"\",36,36,33,40],[\"N3.6c690f8b09f7e27b\",\"documented\",\"\",38,38,35,42],[\"N3.4dec7ed9342cac95\",\"documented\",\"\",40,43,38,45],[\"N3.df4519f5f8918ff8\",\"documented\",\"\",44,47,42,49]],\"end\":49,\"lines\":[[26,\"## The (short) story\"],[27,\"\"],[28,\"Wispr Flow raised **$81 million** to build a voice dictation app.  \"],[29,\"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it.\"],[30,\"\"],[31,\"That's it.  \"],[32,\"No funding. No team. Just one stubborn developer who hates subscriptions.\"],[33,\"\"],[34,\"This is what open source is supposed to be.\"],[35,\"\"],[36,\"---\"],[37,\"\"],[38,\"## Why people actually use it\"],[39,\"\"],[40,\"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**\"],[41,\"- Removes \\\"um\\\", \\\"like\\\", all fillers automatically\"],[42,\"- Fixes grammar, can rephrase, bullet-point, or even generate text\"],[43,\"- Tiny actions already work (\\\"open YouTube\\\", \\\"set 5-min timer\\\")\"],[44,\"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant.\"],[45,\"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)\"],[46,\"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)\"],[47,\"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`\"],[48,\"\"],[49,\"**Zero tracking. Zero telemetry. Zero bullshit.**\"]],\"next_start\":50,\"omissions\":[],\"omitted_cards\":1,\"source_id\":\"S1\",\"start\":26,\"total_lines\":205,\"v\":3,\"view_id\":\"6e752039632cbebac84c202e2a7ae77dbf562e8c69a7e0ab6d67011edb1ff6b3\"}","role":"user"},{"c