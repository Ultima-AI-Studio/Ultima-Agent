d":"84299077-567d-4f11-9187-1f1462a95f48","kind":"intent","order":78,"seq":6},{"at":"445727.9750494","deadline":"445960.109472","file_call_id":"84299077-567d-4f11-9187-1f1462a95f48","kind":"file_end","order":79},{"at":"445728.0806698","deadline":"445960.109472","event_index":11,"kind":"sdk_end","order":80,"seq":6},{"at":"445728.5411752","deadline":"445960.109472","generation":7,"kind":"generation","order":81},{"at":"445728.5413976","deadline":"445960.109472","generation":7,"kind":"send","order":82,"receipt_index":18},{"at":"445728.5421676","deadline":"445960.109472","generation":7,"kind":"return","order":83,"receipt_index":18},{"at":"445728.5423252","deadline":"445960.109472","generation":7,"kind":"send","order":84,"receipt_index":19},{"at":"445728.5443341","deadline":"445960.109472","generation":7,"kind":"return","order":85,"receipt_index":19},{"at":"445728.5478487","deadline":"445960.109472","generation":7,"kind":"send","order":86,"receipt_index":20},{"at":"445731.2800797","deadline":"445960.109472","generation":7,"kind":"return","order":87,"receipt_index":20},{"at":"445731.2859372","deadline":"445960.109472","generation":7,"kind":"secured","order":88}],"transport":{"admitted":{"chat":5328,"metadata":21511},"completed":7,"generations":7,"gets":14,"post_bytes":128195,"posts":7,"receipts":[{"admission_error":null,"admitted":21,"downloaded":21,"entity_bytes":0,"entity_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","error":null,"inspected":21,"kind":"metadata","method":"GET","path":"/api/version","peer_bytes":null,"response_sha256":"fc448849af3360fad86582f3fdcd4b98c5a75c5e9599eacdd6da3e70316e646b","retained":21,"send_reserved":true,"socket_bytes":null,"status":200,"timeout_json":"{\"connect\":25,\"pool\":25,\"read\":25,\"write\":25}"},{"admission_error":null,"admitted":3052,"downloaded":3052,"entity_bytes":0,"entity_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","error":null,"inspected":3052,"kind":"metadata","me