[{"cards":[["N3.fcf66b5fe35b556d","documented","",26,26,26,30],["N3.4bfb1a65cb740e28","documented","",28,29,26,32],["N3.1b876c6a7f2df219","documented","",31,32,28,35],["N3.0d900bd548fb2e7b","documented","",34,34,31,38],["N3.bbf447baa068f16c","documented","",36,36,33,40],["N3.6c690f8b09f7e27b","documented","",38,38,35,42],["N3.4dec7ed9342cac95","documented","",40,43,38,45],["N3.df4519f5f8918ff8","documented","",44,47,42,49]],"end":49,"lines":[[26,"## The (short) story"],[27,""],[28,"Wispr Flow raised **$81 million** to build a voice dictation app.  "],[29,"I got annoyed, spent 3 months of late nights building my own version, and open-sourced it."],[30,""],[31,"That's it.  "],[32,"No funding. No team. Just one stubborn developer who hates subscriptions."],[33,""],[34,"This is what open source is supposed to be."],[35,""],[36,"---"],[37,""],[38,"## Why people actually use it"],[39,""],[40,"- Hold **Fn** → speak → release → clean, punctuated text appears **anywhere**"],[41,"- Removes \"um\", \"like\", all fillers automatically"],[42,"- Fixes grammar, can rephrase, bullet-point, or even generate text"],[43,"- Tiny actions already work (\"open YouTube\", \"set 5-min timer\")"],[44,"- **Full Prompt Engineering:** Every behavior is customizable. Tweak how Jarvis formats mail, cleans dictation, or behaves as an assistant."],[45,"- **Fully offline** with local **Whisper** or **NVIDIA Parakeet** (via Sherpa-ONNX)"],[46,"- **100% Private, Blazingly Fast** support for local LLMs via [Ollama](https://ollama.com)"],[47,"- Or use cloud speed with Deepgram + Gemini (1M tokens/day free) — Deepgram requests default to `mip_opt_out=true`"],[48,""],[49,"**Zero tracking. Zero telemetry. Zero bullshit.**"]],"next_start":50,"omissions":[],"omitted_cards":1,"source_id":"S1","start":26,"total_lines":205,"v":3,"view_id":"6e752039632cbebac84c202e2a7ae77dbf562e8c69a7e0ab6d67011edb1ff6b3"},{"cards":[["N3.321fae92e927b605","documented","",51,51,50,55],["N3.20445d93058eced7","documented","",53,53,50,57],["N3.202e446db2af740c","documented","",55,58,53,60],["N3.123cc50ccab7bae0","documented","",59,59,56,63],["N3.3718e5a6f9c08d94","documented","",61,61,58,65],["N3.0a8790f1ba880368","documented","",63,63,60,67],["N3.2e8143d3b69c0b73","documented","",65,65,62,69],["N3.c05a481a95fb82cf","documented","",67,70,65,72]],"end":73,"lines":[[50,""],[51,"---"],[52,""],[53,"## Download"],[54,""],[55,"| Platform | Link |"],[56,"|----------|------|"],[57,"| 🍎 **Mac** (Apple Silicon) | [Download DMG (M1/M2/M3/M4)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |"],[58,"| 💻 **Mac** (Intel) | [Download DMG (x64)](https://github.com/akshayaggarwal99/jarvis-ai-assistant/releases/latest) |"],[59,"| 📱 **iOS** (iPhone/iPad) | [TestFlight](./ios/README.md) *(NEW!)* |"],[60,""],[61,"✅ Signed & notarized by Apple → no scary warnings."],[62,""],[63,"---"],[64,""],[65,"## Jarvis vs $700M startups"],[66,""],[67,"| | **Jarvis** | The $700M one |"],[68,"|---|:---:|:---:|"],[69,"| 💰 Price | **Free forever** | $10–24/month |"],[70,"| 🔇 Offline / Local | **Yes (Whisper + Parakeet)** | No |"],[71,"| 🔓 Open Source | **Yes (MIT)** | No |"],[72,"| 📡 Telemetry | **None** | ??? |"],[73,"| 👨‍💻 Built by | **1 guy at 2am** | VC money |"]],"next_start":74,"omissions":[],"omitted_cards":1,"source_id":"S1","start":50,"total_lines":205,"v":3,"view_id":"236e3e169e9d29f9298a13da6d5f2d57fd2003a8767dbe888117d3d8e2c2862e"},{"cards":[["N3.5c5e9f7ce3d84d7c","documented","",75,75,74,79],["N3.1da205972f299f86","documented","",77,77,74,81],["N3.ad1ed2a58011fa74","documented","",79,82,77,84],["N3.b9414159109d70a7","documented","",83,86,81,88],["N3.3d3f85c70931eb16","documented","",88,88,85,92],["N3.d1240040db9906a1","documented","",90,90,87,94],["N3.5b666bfc974c4f05","documented","",92,92,89,96],["N3.d92b3e02711dcbd9","documented","",94,94,91,97]],"end":97,"lines":[[74,""],[75,"---"],[76,""],[77,"## Quick setup (30 seconds)"],[78,""],[79,"1. Download & open the app"],[80,"2. **Go Local (Recommended for privacy):**  "],[81,"   - Settings → Transcription → Enable **Local Model**"],[82,"   - Choose **Whisper** (tiny/base/small) or **Parakeet** (NVIDIA's 600M param model)"],[83,"   - Settings → AI Models → Enable **Ollama** (requires [Ollama](https://ollama.com) installed)"],[84,"3. **Or Go Cloud (Recommended for speed/accuracy):**"],[85,"   - Paste free Deepgram + Gemini keys"],[86,"4. Hold Fn and talk"],[87,""],[88,"That's literally it."],[89,""],[90,"---"],[91,""],[92,"## 🦙 Ollama (Local LLM) Support"],[93,""],[94,"Jarvis now supports running any LLM locally via Ollama. It's fast, private, and free."],[95,""],[96,"1.  **Install Ollama:** [Download here](https://ollama.com)"],[97,"2.  **Pull a model:**"]],"next_start":98,"omissions":[],"omitted_cards":0,"source_id":"S1","start":74,"total_lines":205,"v":3,"view_id":"a2222ca58b5fb58385cb2a84f4c19046073f2e8661a6058c6e93bee0eb4b393d"},{"cards":[["N3.2f4aa636dd83300b","code","AgentManager",20,20,20,24],["N3.6fea78c898383bae","code","Logger.debug",31,31,28,35],["N3.618b4c8f01919013","limitation","",39,39,36,43],["N3.1f532fd69aebcce9","code","console.log",42,42,39,43],["N3.8fa817802e51e5f7","code","Logger.info",43,43,40,43]],"end":43,"lines":[[20,"      AgentManager.instance = new AgentManager();"],[21,"    }"],[22,"    return AgentManager.instance;"],[23,"  }"],[24,""],[25,"  async initialize("],[26,"    openaiKey: string | undefined,"],[27,"    geminiKey?: string,"],[28,"    ollamaSettings?: { useOllama?: boolean, ollamaUrl?: string, ollamaModel?: string }"],[29,"  ): Promise<void> {"],[30,"    if (this.isInitialized) {"],[31,"      Logger.debug('🤖 Agent already initialized, skipping...');"],[32,"      return;"],[33,"    }"],[34,""],[35,"    try {"],[36,"      let provider: LLMProvider | null = null;"],[37,""],[38,"      // Priority: Ollama (currently only fully implemented provider)"],[39,"      // TODO: Add OpenAI and Gemini providers when implemented"],[40,""],[41,"      if (ollamaSettings?.useOllama) {"],[42,"        console.log(`[DEBUG] AgentManager: Creating OllamaProvider (${ollamaSettings.ollamaModel})`);"],[43,"        Logger.info(`🦙 Initializing with Ollama provider (${ollamaSettings.ollamaModel})...`);"]],"next_start":44,"omissions":[],"omitted_cards":0,"source_id":"S2","start":20,"total_lines":90,"v":3,"view_id":"5196a25eb17dc419b1fc3ffbfa321018d5a8ced4850f48e7f4e0a40d9c8f2236"},{"cards":[["N3.567d308b0fc81491","code","Logger.info",25,25,25,29],["N3.30e4c0ec1b0784c9","code","Date.now",37,37,34,41],["N3.a206f8ec0d24591b","code","Logger.info",40,40,37,44]],"end":48,"lines":[[25,"        Logger.info(`🤖 [UnifiedAgent] Initialized with ${this.provider.name} provider and ${this.toolRegistry.size} tools`);"],[26,"    }"],[27,""],[28,"    /**"],[29,"     * Process a user query"],[30,"     * Uses function calling to determine if a tool should be used"],[31,"     */"],[32,"    async processQuery("],[33,"        query: string,"],[34,"        sessionId?: string,"],[35,"        userContext?: { userId?: string; displayName?: string; email?: string }"],[36,"    ): Promise<string> {"],[37,"        const startTime = Date.now();"],[38,""],[39,"        try {"],[40,"            Logger.info(`📥 [UnifiedAgent] Processing query: \"${query.substring(0, 50)}...\"`);"],[41,""],[42,"            // If the provider supports tool calling, use it"],[43,"            if (this.provider.supportsToolCalling()) {"],[44,"                return await this.processWithTools(query, startTime);"],[45,"            }"],[46,""],[47,"            // Fallback to text generation for providers without tool support"],[48,"            return await this.processTextOnly(query, startTime);"]],"next_start":49,"omissions":[],"omitted_cards":0,"source_id":"S3","start":25,"total_lines":110,"v":3,"view_id":"d6da46a9bb8ba7c07566f8d6b39697ba1dd162eb49ac457cc46c143b1aa64df6"}]