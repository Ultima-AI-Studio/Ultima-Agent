+    m=module();u,calls,state=fake_user32(held=held)
+    if held:
+        with pytest.raises(ValueError,match='keyboard'):m.manual_start(u,11,tmp_path)
+        assert not (tmp_path/'manual-start.json').exists()
+    else:
+        m.manual_start(u,11,tmp_path)
